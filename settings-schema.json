{
   "layout": {
      "type": "layout",
      "pages": [
         "settings-tab",
         "hotkeys-tab"
      ],
      "settings-tab": {
         "type": "page",
         "title": "Settings",
         "sections": [
            "tiling-section",
            "panel-section",
            "exclusion-section"
         ]
      },
      "hotkeys-tab": {
         "type": "page",
         "title": "Hotkeys",
          "sections": [
              "autotile-hotkey-section",
              "preset-section",
              "resize-section",
              "swap-section",
              "exclusion-hotkey-section"
           ]
      },
      "autotile-hotkey-section": {
         "type": "section",
         "title": "Auto-Tile Hotkeys",
         "keys": [
            "autotile6hotkey",
            "autotile3hotkey",
            "autotileautohotkey",
            "autotileoffhotkey"
         ]
      },
      "preset-section": {
         "type": "section",
         "title": "Workspace Presets",
         "keys": [
            "presetHotkey",
            "presets"
         ]
      },
      "resize-section": {
         "type": "section",
         "title": "Resize tiled windows",
         "keys": [
            "resizeWiderHotkey",
            "resizeNarrowerHotkey",
            "resizeTallerHotkey",
            "resizeShorterHotkey"
         ]
      },
      "swap-section": {
         "type": "section",
         "title": "Swap windows",
         "keys": [
            "swapLeftHotkey",
            "swapRightHotkey",
            "swapUpHotkey",
            "swapDownHotkey"
         ]
      },
      "tiling-section": {
         "type": "section",
         "title": "Tiling",
         "keys": [
            "tileAnimation",
            "focusBorder",
            "fillSingleWindow"
         ]
      },
      "exclusion-section": {
         "type": "section",
         "title": "Never tile",
         "keys": [
            "excludeAppPicker",
            "exclusions"
         ]
      },
      "exclusion-hotkey-section": {
         "type": "section",
         "title": "Never tile",
         "keys": [
            "excludeHotkey"
         ]
      },
      "panel-section": {
         "type": "section",
         "title": "Preset panel",
         "keys": [
            "panelTheme",
            "accentMode",
            "accentColor",
            "stateMode",
            "stateColor"
         ]
      }
   },
   "autotile6hotkey": {
      "type": "keybinding",
      "default": "<Super><Ctrl>6",
      "description": "Tile all windows into 6 columns"
   },
   "autotile3hotkey": {
      "type": "keybinding",
      "default": "<Super><Ctrl>3",
      "description": "Tile all windows into 3 columns"
   },
   "autotileautohotkey": {
      "type": "keybinding",
      "default": "<Super><Ctrl>a",
      "description": "Turn automatic tiling on for this workspace and tile now"
   },
   "autotileoffhotkey": {
      "type": "keybinding",
      "default": "<Super><Ctrl>d",
      "description": "Turn automatic tiling off for this workspace"
   },
   "presetHotkey": {
      "type": "keybinding",
      "default": "<Super><Ctrl>p",
      "description": "Open the preset panel"
   },
   "resizeWiderHotkey": {
      "type": "keybinding",
      "default": "<Super><Alt>Right",
      "description": "Make the focused tiled window wider (tap = 1 px, hold to speed up)"
   },
   "resizeNarrowerHotkey": {
      "type": "keybinding",
      "default": "<Super><Alt>Left",
      "description": "Make the focused tiled window narrower"
   },
   "resizeTallerHotkey": {
      "type": "keybinding",
      "default": "<Super><Alt>Down",
      "description": "Make the focused tiled window taller"
   },
   "resizeShorterHotkey": {
      "type": "keybinding",
      "default": "<Super><Alt>Up",
      "description": "Make the focused tiled window shorter"
   },
   "swapLeftHotkey": {
      "type": "keybinding",
      "default": "<Super><Ctrl>Left",
      "description": "Swap the focused tiled window with its neighbor to the left"
   },
   "swapRightHotkey": {
      "type": "keybinding",
      "default": "<Super><Ctrl>Right",
      "description": "Swap the focused tiled window with its neighbor to the right"
   },
   "swapUpHotkey": {
      "type": "keybinding",
      "default": "<Super><Ctrl>Up",
      "description": "Swap the focused tiled window with its neighbor above"
   },
   "swapDownHotkey": {
      "type": "keybinding",
      "default": "<Super><Ctrl>Down",
      "description": "Swap the focused tiled window with its neighbor below"
   },
   "presets": {
      "type": "string",
      "default": "[]",
      "description": "Preset definitions (JSON)"
   },
   "excludeHotkey": {
      "type": "keybinding",
      "default": "<Super>g",
      "description": "Toggle 'never tile' for the focused window"
   },
   "excludeAppPicker": {
      "type": "combobox",
      "default": "picker",
      "description": "Add an installed application",
      "tooltip": "Pick an application and it is added to the list below. The combobox resets after each pick.",
      "options": {
         "Add application …": "picker"
      }
   },
   "exclusions": {
      "type": "list",
      "description": "Windows matching one of these rows are never tiled; they float freely wherever you put them",
      "columns": [
         {"id": "match", "title": "Match", "type": "string", "options": {"Window class": "class", "Title contains": "title", "App id": "app"}},
         {"id": "text", "title": "Text", "type": "string"}
      ],
      "default": []
   },
   "wsPresets": {
      "type": "string",
      "default": "{}",
      "description": "Workspace to preset assignments (JSON)"
   },
   "autoWorkspaces": {
      "type": "list",
      "description": "Automatic tiling per workspace (set with Super+Ctrl+A / Super+Ctrl+D or in the preset panel; not shown in this dialog)",
      "columns": [
         {"id": "workspace", "title": "Workspace", "type": "integer", "min": 1, "max": 36, "step": 1},
         {"id": "auto", "title": "Tile automatically", "type": "boolean"}
      ],
      "default": []
   },
   "layouts": {
      "type": "generic",
      "default": ""
   },
   "layoutsMigrated": {
      "type": "generic",
      "default": false
   },
   "panelSize": {
      "type": "generic",
      "default": ""
   },
   "windowGap": {
      "type": "spinbutton",
      "description": "Gap between tiled windows (set with − / + in the preset panel; not shown in this dialog)",
      "min": 0,
      "max": 48,
      "step": 2,
      "units": "px",
      "default": 0
   },
   "tileAnimation": {
      "type": "checkbox",
      "default": true,
      "description": "Animate tiling",
      "tooltip": "Windows glide into their new place. Off: they jump there at once."
   },
   "focusBorder": {
      "type": "checkbox",
      "default": true,
      "description": "Border around the focused window",
      "tooltip": "After a Super+Arrow focus move, mark the newly focused window with a thin border in the state color for three seconds."
   },
   "fillSingleWindow": {
      "type": "checkbox",
      "default": false,
      "description": "Fill the monitor with a single window",
      "tooltip": "With automatic tiling or a preset on, a single tiled window fills the whole usable area instead of being left untouched."
   },
   "panelTheme": {
      "type": "combobox",
      "default": "system",
      "description": "Theme of the preset panel",
      "tooltip": "Follow system tracks the desktop color scheme live; Light and Dark override it.",
      "options": {
         "Follow system": "system",
         "Light": "light",
         "Dark": "dark"
      }
   },
   "accentMode": {
      "type": "combobox",
      "default": "theme",
      "description": "Accent color",
      "tooltip": "Follow theme tracks the accent color of the Cinnamon theme live. Custom uses the color below.",
      "options": {
         "Follow theme": "theme",
         "Custom": "own"
      }
   },
   "accentColor": {
      "type": "colorchooser",
      "default": "rgb(255,150,64)",
      "description": "Custom accent color",
      "tooltip": "Accent of the preset panel and editor when Accent color is Custom.",
      "dependency": "accentMode=own"
   },
   "stateMode": {
      "type": "combobox",
      "default": "green",
      "description": "State color",
      "tooltip": "Color of the \"Auto: on\" marker and the assigned rows. Green keeps today's look. Follow theme tracks the accent color of the Cinnamon theme live. Custom uses the color below.",
      "options": {
         "Green": "green",
         "Follow theme": "theme",
         "Custom": "own"
      }
   },
   "stateColor": {
      "type": "colorchooser",
      "default": "rgb(156,224,114)",
      "description": "Custom state color",
      "tooltip": "State color of the preset panel when State color is Custom.",
      "dependency": "stateMode=own"
   }
}
