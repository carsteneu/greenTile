{
    "name": "greenTile",
    "version": "2.1.1",
    "private": true,
    "description": "Window tiling extension for Cinnamon — development tooling only; the shipped extension needs none of this.",
    "license": "GPL-3.0-only",
    "engines": {
        "node": ">=18.18"
    },
    "scripts": {
        "test": "node --test tests/*/*.test.js",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json",
        "check:types": "node scripts/type-contract-check.mjs",
        "check:catalogs": "./scripts/check-catalogs.sh",
        "check": "npm run check:catalogs && npm run test && npm run typecheck && npm run lint && npm run check:types",
        "gen:types": "node scripts/generate-xlet-types.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "eslint": "^9.0.0",
        "globals": "^16.0.0",
        "typescript": "~5.9.0"
    }
}
