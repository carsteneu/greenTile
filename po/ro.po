#. settings-schema.json->excludeAppPicker->options
#: greenTile.js:439
msgid "Add application …"
msgstr "Adaugă aplicație …"

#: greenTile.js:458
msgid "Window floats"
msgstr "Fereastra plutește"

#: greenTile.js:458
msgid "Window tiles again"
msgstr "Fereastra este din nou aranjată"

#: greenTile.js:2771
#, javascript-format
msgid "assigned — workspace %d"
msgstr "atribuit — spațiul de lucru %d"

#: greenTile.js:2832
msgid "Please enter a name."
msgstr "Introdu un nume."

#: greenTile.js:2874
#, javascript-format
msgid "from %d"
msgstr "de la %d"

#: greenTile.js:2991
msgid "Rules (by window count)"
msgstr "Reguli (după numărul de ferestre)"

#: greenTile.js:2995
msgid "Rule"
msgstr "Regulă"

#: greenTile.js:2996
msgid "Delete rule"
msgstr "Șterge regula"

#: greenTile.js:3004
msgid "Rule applies from"
msgstr "Regula se aplică de la"

#: greenTile.js:3011
msgid "windows"
msgstr "ferestre"

#: greenTile.js:3013
msgid "Painter"
msgstr "Zonă de desen"

#: greenTile.js:3028
msgid ""
"Click or drag: the row sets how many windows the column holds. Right-click "
"removes a column."
msgstr ""
"Clic sau trage: rândul stabilește câte ferestre încap în coloană. Clic "
"dreapta elimină o coloană."

#: greenTile.js:3033
msgid "Name"
msgstr "Nume"

#: greenTile.js:3034
msgid "Preset name"
msgstr "Numele presetării"

#: greenTile.js:3039
msgid "Delete preset"
msgstr "Șterge presetarea"

#: greenTile.js:3042
msgid "Really delete?"
msgstr "Ștergi definitiv?"

#: greenTile.js:3043
msgid "Delete"
msgstr "Șterge"

#: greenTile.js:3047
msgid "Save"
msgstr "Salvează"

#: greenTile.js:3072
#, javascript-format
msgid "Result: %s"
msgstr "Rezultat: %s"

#: greenTile.js:3692
msgid "Gap between windows"
msgstr "Spațiu între ferestre"

#: greenTile.js:3697
#, javascript-format
msgid "%d px"
msgstr "%d px"

#: greenTile.js:3716
msgid "Reset sizes"
msgstr "Resetează dimensiunile"

#: greenTile.js:3747
#, javascript-format
msgid "Presets — workspace %d · %s"
msgstr "Presetări — spațiul de lucru %d · %s"

#: greenTile.js:3749
msgid "Create preset"
msgstr "Creează presetare"

#: greenTile.js:3749
#, javascript-format
msgid "Edit %s"
msgstr "Editează %s"

#: greenTile.js:3753
msgid "Back"
msgstr "Înapoi"

#: greenTile.js:3762
msgid "Auto: on"
msgstr "Auto: pornit"

#: greenTile.js:3762
msgid "Auto: off"
msgstr "Auto: oprit"

#: greenTile.js:3783
msgid "Dark theme"
msgstr "Temă întunecată"

#: greenTile.js:3783
msgid "Light theme"
msgstr "Temă luminoasă"

#: greenTile.js:3903
msgid "No presets yet."
msgstr "Nicio presetare încă."

#: greenTile.js:3918
msgid "New preset"
msgstr "Presetare nouă"

#: greenTile.js:3921
msgid "Click a row to apply it to this workspace and tile right away"
msgstr ""
"Dă clic pe un rând pentru a-l aplica acestui spațiu de lucru și a aranja "
"imediat"

#. metadata.json->name
msgid "greenTile"
msgstr "greenTile"

#. metadata.json->description
msgid ""
"Column tiling with per-workspace presets, auto mode and snap-on-release. "
"Fork of gTile by shuairan."
msgstr ""
"Aranjare în coloane cu presetări per spațiu de lucru, mod automat și fixare "
"la eliberare. Fork al gTile de shuairan."

#. settings-schema.json->settings-tab->title
msgid "Settings"
msgstr "Setări"

#. settings-schema.json->hotkeys-tab->title
msgid "Hotkeys"
msgstr "Tastele de acces rapid"

#. settings-schema.json->autotile-hotkey-section->title
msgid "Auto-Tile Hotkeys"
msgstr "Taste rapide pentru aranjarea automată"

#. settings-schema.json->preset-section->title
msgid "Workspace Presets"
msgstr "Presetări pentru spațiile de lucru"

#. settings-schema.json->resize-section->title
msgid "Resize tiled windows"
msgstr "Redimensionare ferestre aranjate"

#. settings-schema.json->swap-section->title
msgid "Swap windows"
msgstr "Schimbare ferestre între ele"

#. settings-schema.json->tiling-section->title
msgid "Tiling"
msgstr "Aranjare"

#. settings-schema.json->exclusion-section->title
#. settings-schema.json->exclusion-hotkey-section->title
msgid "Never tile"
msgstr "Nu aranja niciodată"

#. settings-schema.json->panel-section->title
msgid "Preset panel"
msgstr "Panou de presetări"

#. settings-schema.json->autotile6hotkey->description
msgid "Tile all windows into 6 columns"
msgstr "Aranjează toate ferestrele în 6 coloane"

#. settings-schema.json->autotile3hotkey->description
msgid "Tile all windows into 3 columns"
msgstr "Aranjează toate ferestrele în 3 coloane"

#. settings-schema.json->autotileautohotkey->description
msgid "Turn automatic tiling on for this workspace and tile now"
msgstr ""
"Activează aranjarea automată pentru acest spațiu de lucru și aranjează acum"

#. settings-schema.json->autotileoffhotkey->description
msgid "Turn automatic tiling off for this workspace"
msgstr "Dezactivează aranjarea automată pentru acest spațiu de lucru"

#. settings-schema.json->presetHotkey->description
msgid "Open the preset panel"
msgstr "Deschide panoul de presetări"

#. settings-schema.json->resizeWiderHotkey->description
msgid "Make the focused tiled window wider (tap = 1 px, hold to speed up)"
msgstr ""
"Lărgește fereastra aranjată focalizată (apăsare = 1 px, ține apăsat pentru "
"accelerare)"

#. settings-schema.json->resizeNarrowerHotkey->description
msgid "Make the focused tiled window narrower"
msgstr "Îngustează fereastra aranjată focalizată"

#. settings-schema.json->resizeTallerHotkey->description
msgid "Make the focused tiled window taller"
msgstr "Mărește înălțimea ferestrei aranjate focalizate"

#. settings-schema.json->resizeShorterHotkey->description
msgid "Make the focused tiled window shorter"
msgstr "Micșorează înălțimea ferestrei aranjate focalizate"

#. settings-schema.json->swapLeftHotkey->description
msgid "Swap the focused tiled window with its neighbor to the left"
msgstr "Schimbă fereastra aranjată focalizată cu vecina din stânga"

#. settings-schema.json->swapRightHotkey->description
msgid "Swap the focused tiled window with its neighbor to the right"
msgstr "Schimbă fereastra aranjată focalizată cu vecina din dreapta"

#. settings-schema.json->swapUpHotkey->description
msgid "Swap the focused tiled window with its neighbor above"
msgstr "Schimbă fereastra aranjată focalizată cu vecina de deasupra"

#. settings-schema.json->swapDownHotkey->description
msgid "Swap the focused tiled window with its neighbor below"
msgstr "Schimbă fereastra aranjată focalizată cu vecina de dedesubt"

#. settings-schema.json->presets->description
msgid "Preset definitions (JSON)"
msgstr "Definiții de presetări (JSON)"

#. settings-schema.json->excludeHotkey->description
msgid "Toggle 'never tile' for the focused window"
msgstr "Comută „Nu aranja niciodată” pentru fereastra focalizată"

#. settings-schema.json->excludeAppPicker->description
msgid "Add an installed application"
msgstr "Adaugă o aplicație instalată"

#. settings-schema.json->excludeAppPicker->tooltip
msgid ""
"Pick an application and it is added to the list below. The combobox resets "
"after each pick."
msgstr ""
"Alege o aplicație și aceasta va fi adăugată în lista de mai jos. Lista "
"derulantă se resetează după fiecare alegere."

#. settings-schema.json->exclusions->description
msgid ""
"Windows matching one of these rows are never tiled; they float freely "
"wherever you put them"
msgstr ""
"Ferestrele care corespund unuia dintre aceste rânduri nu sunt aranjate "
"niciodată; ele plutesc liber oriunde le așezi"

#. settings-schema.json->exclusions->columns->title
msgid "Match"
msgstr "Potrivire"

#. settings-schema.json->exclusions->columns->title
msgid "Text"
msgstr "Text"

#. settings-schema.json->wsPresets->description
msgid "Workspace to preset assignments (JSON)"
msgstr "Atribuiri de presetări la spațiile de lucru (JSON)"

#. settings-schema.json->autoWorkspaces->description
msgid ""
"Automatic tiling per workspace (set with Super+Ctrl+A / Super+Ctrl+D or in "
"the preset panel; not shown in this dialog)"
msgstr ""
"Aranjare automată per spațiu de lucru (setată cu Super+Ctrl+A / Super+Ctrl+D"
" sau în panoul de presetări; nu este afișată în acest dialog)"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Workspace"
msgstr "Spațiu de lucru"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Tile automatically"
msgstr "Aranjare automată"

#. settings-schema.json->windowGap->description
msgid ""
"Gap between tiled windows (set with − / + in the preset panel; not shown in "
"this dialog)"
msgstr ""
"Spațiu între ferestrele aranjate (setat cu − / + în panoul de presetări; nu "
"este afișat în acest dialog)"

#. settings-schema.json->windowGap->units
msgid "px"
msgstr "px"

#. settings-schema.json->tileAnimation->description
msgid "Animate tiling"
msgstr "Animează aranjarea"

#. settings-schema.json->tileAnimation->tooltip
msgid "Windows glide into their new place. Off: they jump there at once."
msgstr "Ferestrele alunecă la noul loc. Oprit: sar acolo imediat."

#. settings-schema.json->focusBorder->description
msgid "Border around the focused window"
msgstr "Chenar în jurul ferestrei focalizate"

#. settings-schema.json->focusBorder->tooltip
msgid ""
"After a Super+Arrow focus move, mark the newly focused window with a thin "
"border in the state color for three seconds."
msgstr ""
"După mutarea focalizării cu Super+Săgeată, marchează fereastra nou "
"focalizată cu un chenar subțire în culoarea de stare timp de trei secunde."

#. settings-schema.json->fillSingleWindow->description
msgid "Fill the monitor with a single window"
msgstr "Umple monitorul cu o singură fereastră"

#. settings-schema.json->fillSingleWindow->tooltip
msgid ""
"With automatic tiling or a preset on, a single tiled window fills the whole "
"usable area instead of being left untouched."
msgstr ""
"Când aranjarea automată sau o presetare sunt active, o singură fereastră "
"aranjată umple întreaga zonă utilizabilă în loc să rămână neatinsă."

#. settings-schema.json->panelTheme->description
msgid "Theme of the preset panel"
msgstr "Tema panoului de presetări"

#. settings-schema.json->panelTheme->tooltip
msgid ""
"Follow system tracks the desktop color scheme live; Light and Dark override "
"it."
msgstr ""
"„Urmează sistemul” preia în timp real schema de culori a desktopului; "
"„Luminos” și „Întunecat” o suprascriu."

#. settings-schema.json->panelTheme->options
msgid "Follow system"
msgstr "Urmează sistemul"

#. settings-schema.json->panelTheme->options
msgid "Light"
msgstr "Luminos"

#. settings-schema.json->panelTheme->options
msgid "Dark"
msgstr "Întunecat"

#. settings-schema.json->accentMode->description
msgid "Accent color"
msgstr "Culoare de accent"

#. settings-schema.json->accentMode->tooltip
msgid ""
"Follow theme tracks the accent color of the Cinnamon theme live. Custom uses"
" the color below."
msgstr ""
"„Urmează tema” preia în timp real culoarea de accent a temei Cinnamon. "
"„Personalizat” folosește culoarea de mai jos."

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Follow theme"
msgstr "Urmează tema"

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Custom"
msgstr "Personalizat"

#. settings-schema.json->accentColor->description
msgid "Custom accent color"
msgstr "Culoare de accent personalizată"

#. settings-schema.json->accentColor->tooltip
msgid "Accent of the preset panel and editor when Accent color is Custom."
msgstr ""
"Culoarea de accent a panoului de presetări și a editorului când Culoare de "
"accent este „Personalizat”."

#. settings-schema.json->stateMode->description
msgid "State color"
msgstr "Culoare de stare"

#. settings-schema.json->stateMode->tooltip
msgid ""
"Color of the \"Auto: on\" marker and the assigned rows. Green keeps today's "
"look. Follow theme tracks the accent color of the Cinnamon theme live. "
"Custom uses the color below."
msgstr ""
"Culoarea marcajului „Auto: pornit” și a rândurilor atribuite. „Verde” "
"păstrează aspectul actual. „Urmează tema” preia în timp real culoarea de "
"accent a temei Cinnamon. „Personalizat” folosește culoarea de mai jos."

#. settings-schema.json->stateMode->options
msgid "Green"
msgstr "Verde"

#. settings-schema.json->stateColor->description
msgid "Custom state color"
msgstr "Culoare de stare personalizată"

#. settings-schema.json->stateColor->tooltip
msgid "State color of the preset panel when State color is Custom."
msgstr ""
"Culoarea de stare a panoului de presetări când Culoare de stare este "
"„Personalizat”."

#~ msgid ""
#~ "Draw a thin border in the state color around the focused window while "
#~ "automatic tiling is on."
#~ msgstr ""
#~ "Desenează un chenar subțire în culoarea de stare în jurul ferestrei "
#~ "focalizate cât timp aranjarea automată este activă."
