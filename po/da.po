#. settings-schema.json->excludeAppPicker->options
#: greenTile.js:435
msgid "Add application …"
msgstr "Tilføj program …"

#: greenTile.js:454
msgid "Window floats"
msgstr "Vinduet svæver"

#: greenTile.js:454
msgid "Window tiles again"
msgstr "Vinduet flises igen"

#: greenTile.js:2740
#, javascript-format
msgid "assigned — workspace %d"
msgstr "tildelt — arbejdsområde %d"

#: greenTile.js:2801
msgid "Please enter a name."
msgstr "Angiv et navn."

#: greenTile.js:2843
#, javascript-format
msgid "from %d"
msgstr "fra %d"

#: greenTile.js:2960
msgid "Rules (by window count)"
msgstr "Regler (efter antal vinduer)"

#: greenTile.js:2964
msgid "Rule"
msgstr "Regel"

#: greenTile.js:2965
msgid "Delete rule"
msgstr "Slet regel"

#: greenTile.js:2973
msgid "Rule applies from"
msgstr "Reglen gælder fra"

#: greenTile.js:2980
msgid "windows"
msgstr "vinduer"

#: greenTile.js:2982
msgid "Painter"
msgstr "Tegneflade"

#: greenTile.js:2997
msgid ""
"Click or drag: the row sets how many windows the column holds. Right-click "
"removes a column."
msgstr ""
"Klik eller træk: rækken bestemmer, hvor mange vinduer kolonnen rummer. "
"Højreklik fjerner en kolonne."

#: greenTile.js:3002
msgid "Name"
msgstr "Navn"

#: greenTile.js:3003
msgid "Preset name"
msgstr "Navn på forudindstilling"

#: greenTile.js:3008
msgid "Delete preset"
msgstr "Slet forudindstilling"

#: greenTile.js:3011
msgid "Really delete?"
msgstr "Vil du virkelig slette?"

#: greenTile.js:3012
msgid "Delete"
msgstr "Slet"

#: greenTile.js:3016
msgid "Save"
msgstr "Gem"

#: greenTile.js:3041
#, javascript-format
msgid "Result: %s"
msgstr "Resultat: %s"

#: greenTile.js:3661
msgid "Gap between windows"
msgstr "Afstand mellem vinduer"

#: greenTile.js:3666
#, javascript-format
msgid "%d px"
msgstr "%d px"

#: greenTile.js:3685
msgid "Reset sizes"
msgstr "Nulstil størrelser"

#: greenTile.js:3716
#, javascript-format
msgid "Presets — workspace %d · %s"
msgstr "Forudindstillinger — arbejdsområde %d · %s"

#: greenTile.js:3718
msgid "Create preset"
msgstr "Opret forudindstilling"

#: greenTile.js:3718
#, javascript-format
msgid "Edit %s"
msgstr "Rediger %s"

#: greenTile.js:3722
msgid "Back"
msgstr "Tilbage"

#: greenTile.js:3731
msgid "Auto: on"
msgstr "Auto: til"

#: greenTile.js:3731
msgid "Auto: off"
msgstr "Auto: fra"

#: greenTile.js:3752
msgid "Dark theme"
msgstr "Mørkt tema"

#: greenTile.js:3752
msgid "Light theme"
msgstr "Lyst tema"

#: greenTile.js:3872
msgid "No presets yet."
msgstr "Ingen forudindstillinger endnu."

#: greenTile.js:3887
msgid "New preset"
msgstr "Ny forudindstilling"

#: greenTile.js:3890
msgid "Click a row to apply it to this workspace and tile right away"
msgstr ""
"Klik på en række for at anvende den på dette arbejdsområde og flise med det "
"samme"

#. metadata.json->name
msgid "greenTile"
msgstr "greenTile"

#. metadata.json->description
msgid ""
"Column tiling with per-workspace presets, auto mode and snap-on-release. "
"Fork of gTile by shuairan."
msgstr ""
"Flisning i kolonner med forudindstillinger pr. arbejdsområde, automatisk "
"tilstand og indpasning ved slip. Fork af gTile af shuairan."

#. settings-schema.json->settings-tab->title
msgid "Settings"
msgstr "Indstillinger"

#. settings-schema.json->hotkeys-tab->title
msgid "Hotkeys"
msgstr "Genvejstaster"

#. settings-schema.json->autotile-hotkey-section->title
msgid "Auto-Tile Hotkeys"
msgstr "Genvejstaster til automatisk flisning"

#. settings-schema.json->preset-section->title
msgid "Workspace Presets"
msgstr "Forudindstillinger for arbejdsområder"

#. settings-schema.json->resize-section->title
msgid "Resize tiled windows"
msgstr "Tilpas størrelse på flisede vinduer"

#. settings-schema.json->swap-section->title
msgid "Swap windows"
msgstr "Byt om på vinduer"

#. settings-schema.json->tiling-section->title
msgid "Tiling"
msgstr "Flisning"

#. settings-schema.json->exclusion-section->title
#. settings-schema.json->exclusion-hotkey-section->title
msgid "Never tile"
msgstr "Flis aldrig"

#. settings-schema.json->panel-section->title
msgid "Preset panel"
msgstr "Forudindstillingspanel"

#. settings-schema.json->autotile6hotkey->description
msgid "Tile all windows into 6 columns"
msgstr "Flis alle vinduer i 6 kolonner"

#. settings-schema.json->autotile3hotkey->description
msgid "Tile all windows into 3 columns"
msgstr "Flis alle vinduer i 3 kolonner"

#. settings-schema.json->autotileautohotkey->description
msgid "Turn automatic tiling on for this workspace and tile now"
msgstr "Slå automatisk flisning til for dette arbejdsområde, og flis nu"

#. settings-schema.json->autotileoffhotkey->description
msgid "Turn automatic tiling off for this workspace"
msgstr "Slå automatisk flisning fra for dette arbejdsområde"

#. settings-schema.json->presetHotkey->description
msgid "Open the preset panel"
msgstr "Åbn forudindstillingspanelet"

#. settings-schema.json->resizeWiderHotkey->description
msgid "Make the focused tiled window wider (tap = 1 px, hold to speed up)"
msgstr ""
"Gør det fokuserede flisede vindue bredere (tryk = 1 px, hold nede for at øge "
"farten)"

#. settings-schema.json->resizeNarrowerHotkey->description
msgid "Make the focused tiled window narrower"
msgstr "Gør det fokuserede flisede vindue smallere"

#. settings-schema.json->resizeTallerHotkey->description
msgid "Make the focused tiled window taller"
msgstr "Gør det fokuserede flisede vindue højere"

#. settings-schema.json->resizeShorterHotkey->description
msgid "Make the focused tiled window shorter"
msgstr "Gør det fokuserede flisede vindue lavere"

#. settings-schema.json->swapLeftHotkey->description
msgid "Swap the focused tiled window with its neighbor to the left"
msgstr "Byt det fokuserede flisede vindue om med naboen til venstre"

#. settings-schema.json->swapRightHotkey->description
msgid "Swap the focused tiled window with its neighbor to the right"
msgstr "Byt det fokuserede flisede vindue om med naboen til højre"

#. settings-schema.json->swapUpHotkey->description
msgid "Swap the focused tiled window with its neighbor above"
msgstr "Byt det fokuserede flisede vindue om med naboen ovenover"

#. settings-schema.json->swapDownHotkey->description
msgid "Swap the focused tiled window with its neighbor below"
msgstr "Byt det fokuserede flisede vindue om med naboen nedenunder"

#. settings-schema.json->presets->description
msgid "Preset definitions (JSON)"
msgstr "Definitioner af forudindstillinger (JSON)"

#. settings-schema.json->excludeHotkey->description
msgid "Toggle 'never tile' for the focused window"
msgstr "Slå 'flis aldrig' til/fra for det fokuserede vindue"

#. settings-schema.json->excludeAppPicker->description
msgid "Add an installed application"
msgstr "Tilføj et installeret program"

#. settings-schema.json->excludeAppPicker->tooltip
msgid ""
"Pick an application and it is added to the list below. The combobox resets "
"after each pick."
msgstr ""
"Vælg et program, så føjes det til listen nedenfor. Rullelisten nulstilles "
"efter hvert valg."

#. settings-schema.json->exclusions->description
msgid ""
"Windows matching one of these rows are never tiled; they float freely "
"wherever you put them"
msgstr ""
"Vinduer, der matcher en af disse rækker, flises aldrig; de svæver frit, "
"uanset hvor du placerer dem"

#. settings-schema.json->exclusions->columns->title
msgid "Match"
msgstr "Sammenligning"

#. settings-schema.json->exclusions->columns->title
msgid "Text"
msgstr "Tekst"

#. settings-schema.json->wsPresets->description
msgid "Workspace to preset assignments (JSON)"
msgstr "Tildeling af forudindstillinger til arbejdsområder (JSON)"

#. settings-schema.json->autoWorkspaces->description
msgid ""
"Automatic tiling per workspace (set with Super+Ctrl+A / Super+Ctrl+D or in "
"the preset panel; not shown in this dialog)"
msgstr ""
"Automatisk flisning pr. arbejdsområde (indstilles med Super+Ctrl+A / "
"Super+Ctrl+D eller i forudindstillingspanelet; vises ikke i denne dialog)"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Workspace"
msgstr "Arbejdsområde"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Tile automatically"
msgstr "Flis automatisk"

#. settings-schema.json->windowGap->description
msgid ""
"Gap between tiled windows (set with − / + in the preset panel; not shown in "
"this dialog)"
msgstr ""
"Afstand mellem flisede vinduer (indstilles med − / + i "
"forudindstillingspanelet; vises ikke i denne dialog)"

#. settings-schema.json->windowGap->units
msgid "px"
msgstr "px"

#. settings-schema.json->tileAnimation->description
msgid "Animate tiling"
msgstr "Animér flisning"

#. settings-schema.json->tileAnimation->tooltip
msgid "Windows glide into their new place. Off: they jump there at once."
msgstr ""
"Vinduerne glider på plads på deres nye sted. Fra: de springer straks derhen."

#. settings-schema.json->focusBorder->description
msgid "Border around the focused window"
msgstr "Ramme om det fokuserede vindue"

#. settings-schema.json->focusBorder->tooltip
msgid ""
"After a Super+Arrow focus move, mark the newly focused window with a thin "
"border in the state color for three seconds."
msgstr ""
"Efter et fokusskift med Super+Pil markeres det nyligt fokuserede vindue i "
"tre sekunder med en tynd ramme i statusfarve."

#. settings-schema.json->panelTheme->description
msgid "Theme of the preset panel"
msgstr "Tema for forudindstillingspanelet"

#. settings-schema.json->panelTheme->tooltip
msgid ""
"Follow system tracks the desktop color scheme live; Light and Dark override "
"it."
msgstr ""
"Følg system følger skrivebordets farveskema live; Lyst og Mørkt "
"tilsidesætter det."

#. settings-schema.json->panelTheme->options
msgid "Follow system"
msgstr "Følg system"

#. settings-schema.json->panelTheme->options
msgid "Light"
msgstr "Lyst"

#. settings-schema.json->panelTheme->options
msgid "Dark"
msgstr "Mørkt"

#. settings-schema.json->accentMode->description
msgid "Accent color"
msgstr "Accentfarve"

#. settings-schema.json->accentMode->tooltip
msgid ""
"Follow theme tracks the accent color of the Cinnamon theme live. Custom uses "
"the color below."
msgstr ""
"Følg tema følger Cinnamon-temaets accentfarve live. Tilpasset bruger farven "
"nedenfor."

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Follow theme"
msgstr "Følg tema"

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Custom"
msgstr "Tilpasset"

#. settings-schema.json->accentColor->description
msgid "Custom accent color"
msgstr "Tilpasset accentfarve"

#. settings-schema.json->accentColor->tooltip
msgid "Accent of the preset panel and editor when Accent color is Custom."
msgstr ""
"Accent for forudindstillingspanelet og editoren, når Accentfarve er sat til "
"Tilpasset."

#. settings-schema.json->stateMode->description
msgid "State color"
msgstr "Statusfarve"

#. settings-schema.json->stateMode->tooltip
msgid ""
"Color of the \"Auto: on\" marker and the assigned rows. Green keeps today's "
"look. Follow theme tracks the accent color of the Cinnamon theme live. "
"Custom uses the color below."
msgstr ""
"Farve på markeringen \"Auto: til\" og de tildelte rækker. Grøn bevarer det "
"nuværende udseende. Følg tema følger Cinnamon-temaets accentfarve live. "
"Tilpasset bruger farven nedenfor."

#. settings-schema.json->stateMode->options
msgid "Green"
msgstr "Grøn"

#. settings-schema.json->stateColor->description
msgid "Custom state color"
msgstr "Tilpasset statusfarve"

#. settings-schema.json->stateColor->tooltip
msgid "State color of the preset panel when State color is Custom."
msgstr ""
"Statusfarve for forudindstillingspanelet, når Statusfarve er sat til "
"Tilpasset."

#~ msgid ""
#~ "Draw a thin border in the state color around the focused window while "
#~ "automatic tiling is on."
#~ msgstr ""
#~ "Tegner en tynd ramme i statusfarve rundt om det fokuserede vindue, mens "
#~ "automatisk flisning er slået til."
