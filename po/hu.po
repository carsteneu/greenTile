#: lib/ui/editor.js:66
msgid "Please enter a name."
msgstr "Adj meg egy nevet."

#: lib/ui/editor.js:122
#, javascript-format
msgid "from %d"
msgstr "legalább %d"

#: lib/ui/editor.js:267
msgid "Rules (by window count)"
msgstr "Szabályok (ablakszám szerint)"

#: lib/ui/editor.js:271
msgid "Rule"
msgstr "Szabály"

#: lib/ui/editor.js:272
