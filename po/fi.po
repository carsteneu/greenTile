#. settings-schema.json->excludeAppPicker->options
#: greenTile.js:439
msgid "Add application …"
msgstr "Lisää sovellus …"

#: greenTile.js:458
msgid "Window floats"
msgstr "Ikkuna kelluu"

#: greenTile.js:458
msgid "Window tiles again"
msgstr "Ikkuna laatoitetaan taas"

#: greenTile.js:2771
#, javascript-format
msgid "assigned — workspace %d"
msgstr "määritetty — työtila %d"

#: greenTile.js:2832
msgid "Please enter a name."
msgstr "Anna nimi."

#: greenTile.js:2874
#, javascript-format
msgid "from %d"
msgstr "%d alkaen"

#: greenTile.js:2991
msgid "Rules (by window count)"
msgstr "Säännöt (ikkunamäärän mukaan)"

#: greenTile.js:2995
msgid "Rule"
msgstr "Sääntö"

#: greenTile.js:2996
msgid "Delete rule"
msgstr "Poista sääntö"

#: greenTile.js:3004
msgid "Rule applies from"
msgstr "Sääntö koskee vähintään"

#: greenTile.js:3011
msgid "windows"
msgstr "ikkunaa"

#: greenTile.js:3013
msgid "Painter"
msgstr "Piirtoalue"

#: greenTile.js:3028
msgid ""
"Click or drag: the row sets how many windows the column holds. Right-click "
"removes a column."
msgstr ""
"Napsauta tai vedä: rivi määrää, montako ikkunaa sarakkeeseen mahtuu. Oikea "
"napsautus poistaa sarakkeen."

#: greenTile.js:3033
msgid "Name"
msgstr "Nimi"

#: greenTile.js:3034
msgid "Preset name"
msgstr "Esiasetuksen nimi"

#: greenTile.js:3039
msgid "Delete preset"
msgstr "Poista esiasetus"

#: greenTile.js:3042
msgid "Really delete?"
msgstr "Poistetaanko varmasti?"

#: greenTile.js:3043
msgid "Delete"
msgstr "Poista"

#: greenTile.js:3047
msgid "Save"
msgstr "Tallenna"

#: greenTile.js:3072
#, javascript-format
msgid "Result: %s"
msgstr "Tulos: %s"

#: greenTile.js:3692
msgid "Gap between windows"
msgstr "Ikkunoiden väli"

#: greenTile.js:3697
#, javascript-format
msgid "%d px"
msgstr "%d px"

#: greenTile.js:3716
msgid "Reset sizes"
msgstr "Palauta koot"

#: greenTile.js:3747
#, javascript-format
msgid "Presets — workspace %d · %s"
msgstr "Esiasetukset — työtila %d · %s"

#: greenTile.js:3749
msgid "Create preset"
msgstr "Luo esiasetus"

#: greenTile.js:3749
#, javascript-format
msgid "Edit %s"
msgstr "Muokkaa: %s"

#: greenTile.js:3753
msgid "Back"
msgstr "Takaisin"

#: greenTile.js:3762
msgid "Auto: on"
msgstr "Auto: päällä"

#: greenTile.js:3762
msgid "Auto: off"
msgstr "Auto: pois"

#: greenTile.js:3783
msgid "Dark theme"
msgstr "Tumma teema"

#: greenTile.js:3783
msgid "Light theme"
msgstr "Vaalea teema"

#: greenTile.js:3903
msgid "No presets yet."
msgstr "Ei vielä esiasetuksia."

#: greenTile.js:3918
msgid "New preset"
msgstr "Uusi esiasetus"

#: greenTile.js:3921
msgid "Click a row to apply it to this workspace and tile right away"
msgstr ""
"Napsauta riviä ottaaksesi sen käyttöön tässä työtilassa ja laatoittaaksesi "
"heti"

#. metadata.json->name
msgid "greenTile"
msgstr "greenTile"

#. metadata.json->description
msgid ""
"Column tiling with per-workspace presets, auto mode and snap-on-release. "
"Fork of gTile by shuairan."
msgstr ""
"Ikkunoiden laatoitus sarakkeisiin: työtilakohtaiset esiasetukset, "
"automaattitila ja paikalleen napsahdus vapautettaessa. Haara gTile-"
"laajennuksesta (tekijä shuairan)."

#. settings-schema.json->settings-tab->title
msgid "Settings"
msgstr "Asetukset"

#. settings-schema.json->hotkeys-tab->title
msgid "Hotkeys"
msgstr "Pikanäppäimet"

#. settings-schema.json->autotile-hotkey-section->title
msgid "Auto-Tile Hotkeys"
msgstr "Automaattisen laatoituksen pikanäppäimet"

#. settings-schema.json->preset-section->title
msgid "Workspace Presets"
msgstr "Työtilojen esiasetukset"

#. settings-schema.json->resize-section->title
msgid "Resize tiled windows"
msgstr "Laatoitettujen ikkunoiden koon muuttaminen"

#. settings-schema.json->swap-section->title
msgid "Swap windows"
msgstr "Ikkunoiden paikanvaihto"

#. settings-schema.json->tiling-section->title
msgid "Tiling"
msgstr "Laatoitus"

#. settings-schema.json->exclusion-section->title
#. settings-schema.json->exclusion-hotkey-section->title
msgid "Never tile"
msgstr "Älä koskaan laatoita"

#. settings-schema.json->panel-section->title
msgid "Preset panel"
msgstr "Esiasetuspaneeli"

#. settings-schema.json->autotile6hotkey->description
msgid "Tile all windows into 6 columns"
msgstr "Laatoita kaikki ikkunat 6 sarakkeeseen"

#. settings-schema.json->autotile3hotkey->description
msgid "Tile all windows into 3 columns"
msgstr "Laatoita kaikki ikkunat 3 sarakkeeseen"

#. settings-schema.json->autotileautohotkey->description
msgid "Turn automatic tiling on for this workspace and tile now"
msgstr ""
"Ota automaattinen laatoitus käyttöön tässä työtilassa ja laatoita heti"

#. settings-schema.json->autotileoffhotkey->description
msgid "Turn automatic tiling off for this workspace"
msgstr "Poista automaattinen laatoitus käytöstä tässä työtilassa"

#. settings-schema.json->presetHotkey->description
msgid "Open the preset panel"
msgstr "Avaa esiasetuspaneeli"

#. settings-schema.json->resizeWiderHotkey->description
msgid "Make the focused tiled window wider (tap = 1 px, hold to speed up)"
msgstr ""
"Levennä kohdistettua laatoitettua ikkunaa (napautus = 1 px, pitäminen "
"nopeuttaa)"

#. settings-schema.json->resizeNarrowerHotkey->description
msgid "Make the focused tiled window narrower"
msgstr "Kavenna kohdistettua laatoitettua ikkunaa"

#. settings-schema.json->resizeTallerHotkey->description
msgid "Make the focused tiled window taller"
msgstr "Korota kohdistettua laatoitettua ikkunaa"

#. settings-schema.json->resizeShorterHotkey->description
msgid "Make the focused tiled window shorter"
msgstr "Madalla kohdistettua laatoitettua ikkunaa"

#. settings-schema.json->swapLeftHotkey->description
msgid "Swap the focused tiled window with its neighbor to the left"
msgstr ""
"Vaihda kohdistetun laatoitetun ikkunan paikkaa vasemman naapurin kanssa"

#. settings-schema.json->swapRightHotkey->description
msgid "Swap the focused tiled window with its neighbor to the right"
msgstr "Vaihda kohdistetun laatoitetun ikkunan paikkaa oikean naapurin kanssa"

#. settings-schema.json->swapUpHotkey->description
msgid "Swap the focused tiled window with its neighbor above"
msgstr ""
"Vaihda kohdistetun laatoitetun ikkunan paikkaa yläpuolisen naapurin kanssa"

#. settings-schema.json->swapDownHotkey->description
msgid "Swap the focused tiled window with its neighbor below"
msgstr ""
"Vaihda kohdistetun laatoitetun ikkunan paikkaa alapuolisen naapurin kanssa"

#. settings-schema.json->presets->description
msgid "Preset definitions (JSON)"
msgstr "Esiasetusten määritykset (JSON)"

#. settings-schema.json->excludeHotkey->description
msgid "Toggle 'never tile' for the focused window"
msgstr "Kytke ”Älä koskaan laatoita” päälle tai pois kohdistetulle ikkunalle"

#. settings-schema.json->excludeAppPicker->description
msgid "Add an installed application"
msgstr "Lisää asennettu sovellus"

#. settings-schema.json->excludeAppPicker->tooltip
msgid ""
"Pick an application and it is added to the list below. The combobox resets "
"after each pick."
msgstr ""
"Valitse sovellus, niin se lisätään alla olevaan luetteloon. Valintaluettelo "
"palautuu jokaisen valinnan jälkeen."

#. settings-schema.json->exclusions->description
msgid ""
"Windows matching one of these rows are never tiled; they float freely "
"wherever you put them"
msgstr ""
"Ikkunoita, jotka vastaavat jotakin näistä riveistä, ei koskaan laatoiteta; "
"ne kelluvat vapaasti siellä, mihin ne sijoitat"

#. settings-schema.json->exclusions->columns->title
msgid "Match"
msgstr "Täsmäys"

#. settings-schema.json->exclusions->columns->title
msgid "Text"
msgstr "Teksti"

#. settings-schema.json->wsPresets->description
msgid "Workspace to preset assignments (JSON)"
msgstr "Työtilojen ja esiasetusten liitokset (JSON)"

#. settings-schema.json->autoWorkspaces->description
msgid ""
"Automatic tiling per workspace (set with Super+Ctrl+A / Super+Ctrl+D or in "
"the preset panel; not shown in this dialog)"
msgstr ""
"Automaattinen laatoitus työtilakohtaisesti (asetetaan näppäimillä "
"Super+Ctrl+A / Super+Ctrl+D tai esiasetuspaneelissa; ei näy tässä ikkunassa)"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Workspace"
msgstr "Työtila"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Tile automatically"
msgstr "Laatoita automaattisesti"

#. settings-schema.json->windowGap->description
msgid ""
"Gap between tiled windows (set with − / + in the preset panel; not shown in "
"this dialog)"
msgstr ""
"Laatoitettujen ikkunoiden väli (asetetaan painikkeilla − / + "
"esiasetuspaneelissa; ei näy tässä ikkunassa)"

#. settings-schema.json->windowGap->units
msgid "px"
msgstr "px"

#. settings-schema.json->tileAnimation->description
msgid "Animate tiling"
msgstr "Animoi laatoitus"

#. settings-schema.json->tileAnimation->tooltip
msgid "Windows glide into their new place. Off: they jump there at once."
msgstr ""
"Ikkunat liukuvat uuteen paikkaansa. Pois päältä: ne hyppäävät sinne heti."

#. settings-schema.json->focusBorder->description
msgid "Border around the focused window"
msgstr "Reuna kohdistetun ikkunan ympärillä"

#. settings-schema.json->focusBorder->tooltip
msgid ""
"After a Super+Arrow focus move, mark the newly focused window with a thin "
"border in the state color for three seconds."
msgstr ""
"Kun kohdistus siirretään Super+nuolinäppäimellä, uusi kohdistettu ikkuna "
"merkitään kolmeksi sekunniksi ohuella tilavärisellä reunalla."

#. settings-schema.json->fillSingleWindow->description
msgid "Fill the monitor with a single window"
msgstr "Täytä näyttö yhdellä ikkunalla"

#. settings-schema.json->fillSingleWindow->tooltip
msgid ""
"With automatic tiling or a preset on, a single tiled window fills the whole "
"usable area instead of being left untouched."
msgstr ""
"Kun automaattinen laatoitus tai esiasetus on käytössä, yksi laatoitettu "
"ikkuna täyttää koko käytettävissä olevan alueen sen sijaan että se jäisi "
"koskemattomaksi."

#. settings-schema.json->panelTheme->description
msgid "Theme of the preset panel"
msgstr "Esiasetuspaneelin teema"

#. settings-schema.json->panelTheme->tooltip
msgid ""
"Follow system tracks the desktop color scheme live; Light and Dark override "
"it."
msgstr ""
"”Seuraa järjestelmää” seuraa työpöydän väriteemaa reaaliajassa; ”Vaalea” ja "
"”Tumma” ohittavat sen."

#. settings-schema.json->panelTheme->options
msgid "Follow system"
msgstr "Seuraa järjestelmää"

#. settings-schema.json->panelTheme->options
msgid "Light"
msgstr "Vaalea"

#. settings-schema.json->panelTheme->options
msgid "Dark"
msgstr "Tumma"

#. settings-schema.json->accentMode->description
msgid "Accent color"
msgstr "Korostusväri"

#. settings-schema.json->accentMode->tooltip
msgid ""
"Follow theme tracks the accent color of the Cinnamon theme live. Custom uses"
" the color below."
msgstr ""
"”Seuraa teemaa” käyttää Cinnamon-teeman korostusväriä reaaliajassa. "
"”Mukautettu” käyttää alla olevaa väriä."

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Follow theme"
msgstr "Seuraa teemaa"

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Custom"
msgstr "Mukautettu"

#. settings-schema.json->accentColor->description
msgid "Custom accent color"
msgstr "Mukautettu korostusväri"

#. settings-schema.json->accentColor->tooltip
msgid "Accent of the preset panel and editor when Accent color is Custom."
msgstr ""
"Esiasetuspaneelin ja muokkaimen korostusväri, kun Korostusväri on "
"”Mukautettu”."

#. settings-schema.json->stateMode->description
msgid "State color"
msgstr "Tilaväri"

#. settings-schema.json->stateMode->tooltip
msgid ""
"Color of the \"Auto: on\" marker and the assigned rows. Green keeps today's "
"look. Follow theme tracks the accent color of the Cinnamon theme live. "
"Custom uses the color below."
msgstr ""
"”Auto: päällä” -merkin ja määritettyjen rivien väri. ”Vihreä” säilyttää "
"nykyisen ulkoasun. ”Seuraa teemaa” käyttää Cinnamon-teeman korostusväriä "
"reaaliajassa. ”Mukautettu” käyttää alla olevaa väriä."

#. settings-schema.json->stateMode->options
msgid "Green"
msgstr "Vihreä"

#. settings-schema.json->stateColor->description
msgid "Custom state color"
msgstr "Mukautettu tilaväri"

#. settings-schema.json->stateColor->tooltip
msgid "State color of the preset panel when State color is Custom."
msgstr "Esiasetuspaneelin tilaväri, kun Tilaväri on ”Mukautettu”."

#~ msgid ""
#~ "Draw a thin border in the state color around the focused window while "
#~ "automatic tiling is on."
#~ msgstr ""
#~ "Piirtää ohuen reunan tilaväriin kohdistetun ikkunan ympärille, kun "
#~ "automaattinen laatoitus on päällä."
