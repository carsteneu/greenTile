msgid ""
"Escape:\t\t\tHide greenTile\n"
"Enter or Space:\tCommit current selection\n"
"Left:\t\t\tMove Left inside Grid\n"
"Right:\t\t\tMove Right inside Grid\n"
"Up:\t\t\t\tMove Up inside Grid\n"
"Down:\t\t\tMove Down inside Grid\n"
"<Shift>Left:\t\tInclude column to the Left in selection\n"
"<Shift>Right:\t\tInclude column to the Right in selection\n"
"<Shift>Up:\t\tInclude row Above in selection\n"
"<Shift>Down:\tInclude row Below in selection\n"
"<Alt>Left:\t\tMove to the monitor on the Left\n"
"<Alt>Right:\t\tMove to the monitor on the Right\n"
"<Alt>Up:\t\t\tMove to the monitor Above\n"
"<Alt>Down:\t\tMove to the monitor Below\n"
"1:\t\t\t\tSelect the first grid layout\n"
"2:\t\t\t\tSelect the second grid layout\n"
"3:\t\t\t\tSelect the third grid layout\n"
"4:\t\t\t\tSelect the fourth grid layout"
msgstr ""
"Escape:\t\t\tẨn gTile\n"
"Enter hoặc Space:\tXác nhận lựa chọn hiện tại\n"
"Trái:\t\t\tDi chuyển Trái trong Lưới\n"
"Phải:\t\t\tDi chuyển Phải trong Lưới\n"
"Lên:\t\t\t\tDi chuyển Lên trong Lưới\n"
"Xuống:\t\t\tDi chuyển Xuống trong Lưới\n"
"<Shift>Trái:\t\tBao gồm cột bên Trái vào lựa chọn\n"
"<Shift>Phải:\t\tBao gồm cột bên Phải vào lựa chọn\n"
"<Shift>Lên:\t\tBao gồm hàng Bên trên vào lựa chọn\n"
"<Shift>Xuống:\tBao gồm hàng Bên dưới vào lựa chọn\n"
"<Alt>Trái:\t\tDi chuyển đến màn hình bên Trái\n"
"<Alt>Phải:\t\tDi chuyển đến màn hình bên Phải\n"
"<Alt>Lên:\t\t\tDi chuyển đến màn hình Bên trên\n"
"<Alt>Xuống:\t\tDi chuyển đến màn hình Bên dưới\n"
"1:\t\t\t\tChọn bố cục lưới đầu tiên\n"
"2:\t\t\t\tChọn bố cục lưới thứ hai\n"
"3:\t\t\t\tChọn bố cục lưới thứ ba\n"
"4:\t\t\t\tChọn bố cục lưới thứ tư"

