#. settings-schema.json->excludeAppPicker->options
#: greenTile.js:439
msgid "Add application …"
msgstr "Thêm ứng dụng …"

#: greenTile.js:458
msgid "Window floats"
msgstr "Cửa sổ nổi tự do"

#: greenTile.js:458
msgid "Window tiles again"
msgstr "Cửa sổ được xếp ô lại"

#: greenTile.js:2771
#, javascript-format
msgid "assigned — workspace %d"
msgstr "đã gán — không gian làm việc %d"

#: greenTile.js:2832
msgid "Please enter a name."
msgstr "Vui lòng nhập tên."

#: greenTile.js:2874
#, javascript-format
msgid "from %d"
msgstr "từ %d"

#: greenTile.js:2991
msgid "Rules (by window count)"
msgstr "Quy tắc (theo số cửa sổ)"

#: greenTile.js:2995
msgid "Rule"
msgstr "Quy tắc"

#: greenTile.js:2996
msgid "Delete rule"
msgstr "Xóa quy tắc"

#: greenTile.js:3004
msgid "Rule applies from"
msgstr "Quy tắc áp dụng từ"

#: greenTile.js:3011
msgid "windows"
msgstr "cửa sổ"

#: greenTile.js:3013
msgid "Painter"
msgstr "Vùng vẽ"

#: greenTile.js:3028
msgid ""
"Click or drag: the row sets how many windows the column holds. Right-click "
"removes a column."
msgstr ""
"Nhấp hoặc kéo: hàng xác định số cửa sổ trong cột. Nhấp chuột phải để xóa một"
" cột."

#: greenTile.js:3033
msgid "Name"
msgstr "Tên"

#: greenTile.js:3034
msgid "Preset name"
msgstr "Tên cấu hình sẵn"

#: greenTile.js:3039
msgid "Delete preset"
msgstr "Xóa cấu hình sẵn"

#: greenTile.js:3042
msgid "Really delete?"
msgstr "Xóa thật chứ?"

#: greenTile.js:3043
msgid "Delete"
msgstr "Xóa"

#: greenTile.js:3047
msgid "Save"
msgstr "Lưu"

#: greenTile.js:3072
#, javascript-format
msgid "Result: %s"
msgstr "Kết quả: %s"

#: greenTile.js:3692
msgid "Gap between windows"
msgstr "Khoảng cách giữa các cửa sổ"

#: greenTile.js:3697
#, javascript-format
msgid "%d px"
msgstr "%d px"

#: greenTile.js:3716
msgid "Reset sizes"
msgstr "Đặt lại kích thước"

#: greenTile.js:3747
#, javascript-format
msgid "Presets — workspace %d · %s"
msgstr "Cấu hình sẵn — không gian làm việc %d · %s"

#: greenTile.js:3749
msgid "Create preset"
msgstr "Tạo cấu hình sẵn"

#: greenTile.js:3749
#, javascript-format
msgid "Edit %s"
msgstr "Sửa %s"

#: greenTile.js:3753
msgid "Back"
msgstr "Quay lại"

#: greenTile.js:3762
msgid "Auto: on"
msgstr "Tự động: bật"

#: greenTile.js:3762
msgid "Auto: off"
msgstr "Tự động: tắt"

#: greenTile.js:3783
msgid "Dark theme"
msgstr "Chủ đề tối"

#: greenTile.js:3783
msgid "Light theme"
msgstr "Chủ đề sáng"

#: greenTile.js:3903
msgid "No presets yet."
msgstr "Chưa có cấu hình sẵn nào."

#: greenTile.js:3918
msgid "New preset"
msgstr "Cấu hình sẵn mới"

#: greenTile.js:3921
msgid "Click a row to apply it to this workspace and tile right away"
msgstr ""
"Nhấp vào một hàng để áp dụng cho không gian làm việc này và xếp ô ngay"

#. metadata.json->name
msgid "greenTile"
msgstr "greenTile"

#. metadata.json->description
msgid ""
"Column tiling with per-workspace presets, auto mode and snap-on-release. "
"Fork of gTile by shuairan."
msgstr ""
"Xếp ô theo cột với cấu hình sẵn cho từng không gian làm việc, chế độ tự động"
" và tự khớp khi thả. Bản fork của gTile do shuairan phát triển."

#. settings-schema.json->settings-tab->title
msgid "Settings"
msgstr "Cài đặt"

#. settings-schema.json->hotkeys-tab->title
msgid "Hotkeys"
msgstr "Phím tắt"

#. settings-schema.json->autotile-hotkey-section->title
msgid "Auto-Tile Hotkeys"
msgstr "Phím tắt tự động xếp ô"

#. settings-schema.json->preset-section->title
msgid "Workspace Presets"
msgstr "Cấu hình sẵn cho không gian làm việc"

#. settings-schema.json->resize-section->title
msgid "Resize tiled windows"
msgstr "Đổi kích thước cửa sổ đã xếp ô"

#. settings-schema.json->swap-section->title
msgid "Swap windows"
msgstr "Hoán đổi cửa sổ"

#. settings-schema.json->tiling-section->title
msgid "Tiling"
msgstr "Xếp ô"

#. settings-schema.json->exclusion-section->title
#. settings-schema.json->exclusion-hotkey-section->title
msgid "Never tile"
msgstr "Không bao giờ xếp ô"

#. settings-schema.json->panel-section->title
msgid "Preset panel"
msgstr "Bảng cấu hình sẵn"

#. settings-schema.json->autotile6hotkey->description
msgid "Tile all windows into 6 columns"
msgstr "Xếp tất cả cửa sổ thành 6 cột"

#. settings-schema.json->autotile3hotkey->description
msgid "Tile all windows into 3 columns"
msgstr "Xếp tất cả cửa sổ thành 3 cột"

#. settings-schema.json->autotileautohotkey->description
msgid "Turn automatic tiling on for this workspace and tile now"
msgstr "Bật tự động xếp ô cho không gian làm việc này và xếp ô ngay"

#. settings-schema.json->autotileoffhotkey->description
msgid "Turn automatic tiling off for this workspace"
msgstr "Tắt tự động xếp ô cho không gian làm việc này"

#. settings-schema.json->presetHotkey->description
msgid "Open the preset panel"
msgstr "Mở bảng cấu hình sẵn"

#. settings-schema.json->resizeWiderHotkey->description
msgid "Make the focused tiled window wider (tap = 1 px, hold to speed up)"
msgstr ""
"Làm cửa sổ đã xếp ô có tiêu điểm rộng hơn (nhấn = 1 px, giữ để tăng tốc)"

#. settings-schema.json->resizeNarrowerHotkey->description
msgid "Make the focused tiled window narrower"
msgstr "Làm cửa sổ đã xếp ô có tiêu điểm hẹp hơn"

#. settings-schema.json->resizeTallerHotkey->description
msgid "Make the focused tiled window taller"
msgstr "Làm cửa sổ đã xếp ô có tiêu điểm cao hơn"

#. settings-schema.json->resizeShorterHotkey->description
msgid "Make the focused tiled window shorter"
msgstr "Làm cửa sổ đã xếp ô có tiêu điểm thấp hơn"

#. settings-schema.json->swapLeftHotkey->description
msgid "Swap the focused tiled window with its neighbor to the left"
msgstr "Hoán đổi cửa sổ đã xếp ô có tiêu điểm với cửa sổ bên trái"

#. settings-schema.json->swapRightHotkey->description
msgid "Swap the focused tiled window with its neighbor to the right"
msgstr "Hoán đổi cửa sổ đã xếp ô có tiêu điểm với cửa sổ bên phải"

#. settings-schema.json->swapUpHotkey->description
msgid "Swap the focused tiled window with its neighbor above"
msgstr "Hoán đổi cửa sổ đã xếp ô có tiêu điểm với cửa sổ phía trên"

#. settings-schema.json->swapDownHotkey->description
msgid "Swap the focused tiled window with its neighbor below"
msgstr "Hoán đổi cửa sổ đã xếp ô có tiêu điểm với cửa sổ phía dưới"

#. settings-schema.json->presets->description
msgid "Preset definitions (JSON)"
msgstr "Định nghĩa cấu hình sẵn (JSON)"

#. settings-schema.json->excludeHotkey->description
msgid "Toggle 'never tile' for the focused window"
msgstr "Bật/tắt “Không bao giờ xếp ô” cho cửa sổ có tiêu điểm"

#. settings-schema.json->excludeAppPicker->description
msgid "Add an installed application"
msgstr "Thêm một ứng dụng đã cài đặt"

#. settings-schema.json->excludeAppPicker->tooltip
msgid ""
"Pick an application and it is added to the list below. The combobox resets "
"after each pick."
msgstr ""
"Chọn một ứng dụng để thêm vào danh sách bên dưới. Hộp chọn sẽ được đặt lại "
"sau mỗi lần chọn."

#. settings-schema.json->exclusions->description
msgid ""
"Windows matching one of these rows are never tiled; they float freely "
"wherever you put them"
msgstr ""
"Cửa sổ khớp với một trong các dòng này sẽ không bao giờ được xếp ô; chúng "
"nổi tự do ở bất cứ đâu bạn đặt"

#. settings-schema.json->exclusions->columns->title
msgid "Match"
msgstr "Khớp theo"

#. settings-schema.json->exclusions->columns->title
msgid "Text"
msgstr "Văn bản"

#. settings-schema.json->wsPresets->description
msgid "Workspace to preset assignments (JSON)"
msgstr "Gán cấu hình sẵn cho không gian làm việc (JSON)"

#. settings-schema.json->autoWorkspaces->description
msgid ""
"Automatic tiling per workspace (set with Super+Ctrl+A / Super+Ctrl+D or in "
"the preset panel; not shown in this dialog)"
msgstr ""
"Tự động xếp ô theo từng không gian làm việc (đặt bằng Super+Ctrl+A / "
"Super+Ctrl+D hoặc trong bảng cấu hình sẵn; không hiển thị trong hộp thoại "
"này)"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Workspace"
msgstr "Không gian làm việc"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Tile automatically"
msgstr "Tự động xếp ô"

#. settings-schema.json->windowGap->description
msgid ""
"Gap between tiled windows (set with − / + in the preset panel; not shown in "
"this dialog)"
msgstr ""
"Khoảng cách giữa các cửa sổ đã xếp ô (đặt bằng − / + trong bảng cấu hình "
"sẵn; không hiển thị trong hộp thoại này)"

#. settings-schema.json->windowGap->units
msgid "px"
msgstr "px"

#. settings-schema.json->tileAnimation->description
msgid "Animate tiling"
msgstr "Hiệu ứng động khi xếp ô"

#. settings-schema.json->tileAnimation->tooltip
msgid "Windows glide into their new place. Off: they jump there at once."
msgstr "Cửa sổ lướt êm đến vị trí mới. Tắt: chúng nhảy đến đó ngay lập tức."

#. settings-schema.json->focusBorder->description
msgid "Border around the focused window"
msgstr "Viền quanh cửa sổ có tiêu điểm"

#. settings-schema.json->focusBorder->tooltip
msgid ""
"After a Super+Arrow focus move, mark the newly focused window with a thin "
"border in the state color for three seconds."
msgstr ""
"Sau khi chuyển tiêu điểm bằng Super+Mũi tên, đánh dấu cửa sổ vừa nhận tiêu "
"điểm bằng một viền mảnh màu trạng thái trong ba giây."

#. settings-schema.json->fillSingleWindow->description
msgid "Fill the monitor with a single window"
msgstr "Lấp đầy màn hình bằng một cửa sổ duy nhất"

#. settings-schema.json->fillSingleWindow->tooltip
msgid ""
"With automatic tiling or a preset on, a single tiled window fills the whole "
"usable area instead of being left untouched."
msgstr ""
"Khi tự động xếp ô hoặc một cấu hình sẵn đang bật, một cửa sổ được xếp ô duy "
"nhất sẽ lấp đầy toàn bộ khu vực sử dụng được thay vì để nguyên như vậy."

#. settings-schema.json->panelTheme->description
msgid "Theme of the preset panel"
msgstr "Chủ đề của bảng cấu hình sẵn"

#. settings-schema.json->panelTheme->tooltip
msgid ""
"Follow system tracks the desktop color scheme live; Light and Dark override "
"it."
msgstr ""
"“Theo hệ thống” bám theo bảng màu của màn hình nền theo thời gian thực; "
"“Sáng” và “Tối” sẽ ghi đè lên."

#. settings-schema.json->panelTheme->options
msgid "Follow system"
msgstr "Theo hệ thống"

#. settings-schema.json->panelTheme->options
msgid "Light"
msgstr "Sáng"

#. settings-schema.json->panelTheme->options
msgid "Dark"
msgstr "Tối"

#. settings-schema.json->accentMode->description
msgid "Accent color"
msgstr "Màu nhấn"

#. settings-schema.json->accentMode->tooltip
msgid ""
"Follow theme tracks the accent color of the Cinnamon theme live. Custom uses"
" the color below."
msgstr ""
"“Theo chủ đề” lấy màu nhấn của chủ đề Cinnamon theo thời gian thực. “Tùy "
"chỉnh” dùng màu bên dưới."

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Follow theme"
msgstr "Theo chủ đề"

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Custom"
msgstr "Tùy chỉnh"

#. settings-schema.json->accentColor->description
msgid "Custom accent color"
msgstr "Màu nhấn tùy chỉnh"

#. settings-schema.json->accentColor->tooltip
msgid "Accent of the preset panel and editor when Accent color is Custom."
msgstr ""
"Màu nhấn của bảng cấu hình sẵn và trình chỉnh sửa khi “Màu nhấn” là “Tùy "
"chỉnh”."

#. settings-schema.json->stateMode->description
msgid "State color"
msgstr "Màu trạng thái"

#. settings-schema.json->stateMode->tooltip
msgid ""
"Color of the \"Auto: on\" marker and the assigned rows. Green keeps today's "
"look. Follow theme tracks the accent color of the Cinnamon theme live. "
"Custom uses the color below."
msgstr ""
"Màu của dấu “Tự động: bật” và các hàng đã gán. “Xanh lá” giữ giao diện hiện "
"tại. “Theo chủ đề” lấy màu nhấn của chủ đề Cinnamon theo thời gian thực. "
"“Tùy chỉnh” dùng màu bên dưới."

#. settings-schema.json->stateMode->options
msgid "Green"
msgstr "Xanh lá"

#. settings-schema.json->stateColor->description
msgid "Custom state color"
msgstr "Màu trạng thái tùy chỉnh"

#. settings-schema.json->stateColor->tooltip
msgid "State color of the preset panel when State color is Custom."
msgstr ""
"Màu trạng thái của bảng cấu hình sẵn khi “Màu trạng thái” là “Tùy chỉnh”."

#~ msgid ""
#~ "Draw a thin border in the state color around the focused window while "
#~ "automatic tiling is on."
#~ msgstr ""
#~ "Vẽ một viền mảnh bằng màu trạng thái quanh cửa sổ có tiêu điểm khi tự động "
#~ "xếp ô đang bật."
