#. settings-schema.json->autoWorkspaces->tooltip
msgid ""
"One row per workspace (number as shown in the preset panel). Super+Ctrl+A "
"and Super+Ctrl+D add or update rows. Workspaces without a row tile "
"automatically only when they have a preset."
msgstr ""

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Workspace"
msgstr ""

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Tile automatically"
msgstr ""

#. settings-schema.json->auto-workspaces-legend->description
msgid ""
"Super+Ctrl+A turns automatic tiling on for the active workspace and tiles "
"right away, Super+Ctrl+D turns it off (a preset stays assigned but is "
"paused). Workspaces without a row: on with a preset, off without. Removing a "
"row returns the workspace to that rule."
msgstr ""

