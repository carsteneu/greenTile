msgid "Animation"
msgstr "Animazioa"

#. settings-schema.json->autoclose->description
msgid "Auto-Close"
msgstr "Automatikoki itxi"

#. settings-schema.json->aspect-ratio->description
msgid "Use monitor aspect ratio"
msgstr "Erabili monitorearen itxura erlazioa"

#. settings-schema.json->aspect-ratio->tooltip
msgid ""
"Should the popup's grid reflect the current monitor's aspect ratio or not."
msgstr "Laster-lehioaren sareak monitorearen itxura islatzen duen ala ez."

#. settings-schema.json->useMonitorCenter->description
msgid "UI always centered to monitor"
msgstr "Erabiltzaile Interfazea monitorera zentratuta dago beti"

#. settings-schema.json->useMonitorCenter->tooltip
msgid ""
"By default the grid UI shows up in the middle of the active window. With "
"this, it always displays in the middle of the monitor."
msgstr ""
"Besterik ezean, Erabiltzaile Interfaze sarea leiho aktiboaren erdianagertzen "
"da. Honekin, monitorearen erdian agertzen da beti."

#. settings-schema.json->showGridOnAllMonitors->description
msgid "Show UI and all monitors at the same time"
msgstr "Erakutsi Erabiltzaile Interfazea eta monitore guztiak aldi berean."

#. settings-schema.json->grid1NameOverride->description
msgid "Name Override on the UI"
msgstr "Izen Jainjarria Erabiltzaile Interfazean"

