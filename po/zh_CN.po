#. settings-schema.json->excludeAppPicker->options
#: greenTile.js:435
msgid "Add application …"
msgstr "添加应用程序…"

#: greenTile.js:454
msgid "Window floats"
msgstr "窗口已浮动"

#: greenTile.js:454
msgid "Window tiles again"
msgstr "窗口已恢复平铺"

#: greenTile.js:2740
#, javascript-format
msgid "assigned — workspace %d"
msgstr "已分配 — 工作区 %d"

#: greenTile.js:2801
msgid "Please enter a name."
msgstr "请输入名称。"

#: greenTile.js:2843
#, javascript-format
msgid "from %d"
msgstr "%d 个及以上"

#: greenTile.js:2960
msgid "Rules (by window count)"
msgstr "规则（按窗口数量）"

#: greenTile.js:2964
