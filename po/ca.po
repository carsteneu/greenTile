#. settings-schema.json->excludeAppPicker->options
#: greenTile.js:439
msgid "Add application …"
msgstr "Afegeix una aplicació …"

#: greenTile.js:458
msgid "Window floats"
msgstr "La finestra flota"

#: greenTile.js:458
msgid "Window tiles again"
msgstr "La finestra torna al mosaic"

#: greenTile.js:2771
#, javascript-format
msgid "assigned — workspace %d"
msgstr "assignada — espai de treball %d"

#: greenTile.js:2832
msgid "Please enter a name."
msgstr "Introdueix un nom."

#: greenTile.js:2874
#, javascript-format
msgid "from %d"
msgstr "a partir de %d"

#: greenTile.js:2991
msgid "Rules (by window count)"
msgstr "Regles (segons el nombre de finestres)"

#: greenTile.js:2995
msgid "Rule"
msgstr "Regla"

#: greenTile.js:2996
msgid "Delete rule"
msgstr "Esborra la regla"

#: greenTile.js:3004
msgid "Rule applies from"
msgstr "La regla s'aplica a partir de"

#: greenTile.js:3011
msgid "windows"
msgstr "finestres"

#: greenTile.js:3013
msgid "Painter"
msgstr "Àrea de dibuix"

#: greenTile.js:3028
msgid ""
"Click or drag: the row sets how many windows the column holds. Right-click "
"removes a column."
msgstr ""
"Fes clic o arrossega: la fila determina quantes finestres té la columna. El "
"clic dret elimina una columna."

#: greenTile.js:3033
msgid "Name"
msgstr "Nom"

#: greenTile.js:3034
msgid "Preset name"
msgstr "Nom de la predefinició"

#: greenTile.js:3039
msgid "Delete preset"
msgstr "Esborra la predefinició"

#: greenTile.js:3042
msgid "Really delete?"
msgstr "Segur que la vols esborrar?"

#: greenTile.js:3043
msgid "Delete"
msgstr "Esborra"

#: greenTile.js:3047
msgid "Save"
msgstr "Desa"

#: greenTile.js:3072
#, javascript-format
msgid "Result: %s"
msgstr "Resultat: %s"

#: greenTile.js:3692
msgid "Gap between windows"
msgstr "Espai entre finestres"

#: greenTile.js:3697
#, javascript-format
msgid "%d px"
msgstr "%d px"

#: greenTile.js:3716
msgid "Reset sizes"
msgstr "Restableix les mides"

#: greenTile.js:3747
#, javascript-format
msgid "Presets — workspace %d · %s"
msgstr "Predefinicions — espai de treball %d · %s"

#: greenTile.js:3749
msgid "Create preset"
msgstr "Crea una predefinició"

#: greenTile.js:3749
#, javascript-format
msgid "Edit %s"
msgstr "Edita %s"

#: greenTile.js:3753
msgid "Back"
msgstr "Enrere"

#: greenTile.js:3762
msgid "Auto: on"
msgstr "Auto: activat"

#: greenTile.js:3762
msgid "Auto: off"
msgstr "Auto: desactivat"

#: greenTile.js:3783
msgid "Dark theme"
msgstr "Tema fosc"

#: greenTile.js:3783
msgid "Light theme"
msgstr "Tema clar"

#: greenTile.js:3903
msgid "No presets yet."
msgstr "Encara no hi ha cap predefinició."

#: greenTile.js:3918
msgid "New preset"
msgstr "Predefinició nova"

#: greenTile.js:3921
msgid "Click a row to apply it to this workspace and tile right away"
msgstr ""
"Fes clic en una fila per aplicar-la a aquest espai de treball i posar les "
"finestres en mosaic immediatament"

#. metadata.json->name
msgid "greenTile"
msgstr "greenTile"

#. metadata.json->description
msgid ""
"Column tiling with per-workspace presets, auto mode and snap-on-release. "
"Fork of gTile by shuairan."
msgstr ""
"Mosaic en columnes amb predefinicions per espai de treball, mode automàtic i"
" ajust en deixar anar. Bifurcació del gTile de shuairan."

#. settings-schema.json->settings-tab->title
msgid "Settings"
msgstr "Configuració"

#. settings-schema.json->hotkeys-tab->title
msgid "Hotkeys"
msgstr "Dreceres"

#. settings-schema.json->autotile-hotkey-section->title
msgid "Auto-Tile Hotkeys"
msgstr "Dreceres del mosaic automàtic"

#. settings-schema.json->preset-section->title
msgid "Workspace Presets"
msgstr "Predefinicions dels espais de treball"

#. settings-schema.json->resize-section->title
msgid "Resize tiled windows"
msgstr "Redimensiona les finestres en mosaic"

#. settings-schema.json->swap-section->title
msgid "Swap windows"
msgstr "Intercanvia les finestres"

#. settings-schema.json->tiling-section->title
msgid "Tiling"
msgstr "Mosaic"

#. settings-schema.json->exclusion-section->title
#. settings-schema.json->exclusion-hotkey-section->title
msgid "Never tile"
msgstr "No posar mai en mosaic"

#. settings-schema.json->panel-section->title
msgid "Preset panel"
msgstr "Tauler de predefinicions"

#. settings-schema.json->autotile6hotkey->description
msgid "Tile all windows into 6 columns"
msgstr "Posa totes les finestres en mosaic de 6 columnes"

#. settings-schema.json->autotile3hotkey->description
msgid "Tile all windows into 3 columns"
msgstr "Posa totes les finestres en mosaic de 3 columnes"

#. settings-schema.json->autotileautohotkey->description
msgid "Turn automatic tiling on for this workspace and tile now"
msgstr ""
"Activa el mosaic automàtic en aquest espai de treball i posa les finestres "
"en mosaic ara"

#. settings-schema.json->autotileoffhotkey->description
msgid "Turn automatic tiling off for this workspace"
msgstr "Desactiva el mosaic automàtic en aquest espai de treball"

#. settings-schema.json->presetHotkey->description
msgid "Open the preset panel"
msgstr "Obre el tauler de predefinicions"

#. settings-schema.json->resizeWiderHotkey->description
msgid "Make the focused tiled window wider (tap = 1 px, hold to speed up)"
msgstr ""
"Fes més ampla la finestra enfocada en mosaic (toc = 1 px, mantén premut per "
"accelerar)"

#. settings-schema.json->resizeNarrowerHotkey->description
msgid "Make the focused tiled window narrower"
msgstr "Fes més estreta la finestra enfocada en mosaic"

#. settings-schema.json->resizeTallerHotkey->description
msgid "Make the focused tiled window taller"
msgstr "Fes més alta la finestra enfocada en mosaic"

#. settings-schema.json->resizeShorterHotkey->description
msgid "Make the focused tiled window shorter"
msgstr "Fes més baixa la finestra enfocada en mosaic"

#. settings-schema.json->swapLeftHotkey->description
msgid "Swap the focused tiled window with its neighbor to the left"
msgstr "Intercanvia la finestra enfocada en mosaic amb la veïna de l'esquerra"

#. settings-schema.json->swapRightHotkey->description
msgid "Swap the focused tiled window with its neighbor to the right"
msgstr "Intercanvia la finestra enfocada en mosaic amb la veïna de la dreta"

#. settings-schema.json->swapUpHotkey->description
msgid "Swap the focused tiled window with its neighbor above"
msgstr "Intercanvia la finestra enfocada en mosaic amb la veïna de dalt"

#. settings-schema.json->swapDownHotkey->description
msgid "Swap the focused tiled window with its neighbor below"
msgstr "Intercanvia la finestra enfocada en mosaic amb la veïna de baix"

#. settings-schema.json->presets->description
msgid "Preset definitions (JSON)"
msgstr "Definicions de les predefinicions (JSON)"

#. settings-schema.json->excludeHotkey->description
msgid "Toggle 'never tile' for the focused window"
msgstr "Commuta «no posar mai en mosaic» per a la finestra enfocada"

#. settings-schema.json->excludeAppPicker->description
msgid "Add an installed application"
msgstr "Afegeix una aplicació instal·lada"

#. settings-schema.json->excludeAppPicker->tooltip
msgid ""
"Pick an application and it is added to the list below. The combobox resets "
"after each pick."
msgstr ""
"Tria una aplicació i s'afegirà a la llista de sota. El quadre combinat es "
"restableix després de cada tria."

#. settings-schema.json->exclusions->description
msgid ""
"Windows matching one of these rows are never tiled; they float freely "
"wherever you put them"
msgstr ""
"Les finestres que coincideixen amb alguna d'aquestes files no es posen mai "
"en mosaic; floten lliurement allà on les deixis"

#. settings-schema.json->exclusions->columns->title
msgid "Match"
msgstr "Coincidència"

#. settings-schema.json->exclusions->columns->title
msgid "Text"
msgstr "Text"

#. settings-schema.json->wsPresets->description
msgid "Workspace to preset assignments (JSON)"
msgstr "Assignacions de predefinicions als espais de treball (JSON)"

#. settings-schema.json->autoWorkspaces->description
msgid ""
"Automatic tiling per workspace (set with Super+Ctrl+A / Super+Ctrl+D or in "
"the preset panel; not shown in this dialog)"
msgstr ""
"Mosaic automàtic per espai de treball (es defineix amb Super+Ctrl+A / "
"Super+Ctrl+D o al tauler de predefinicions; no es mostra en aquest diàleg)"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Workspace"
msgstr "Espai de treball"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Tile automatically"
msgstr "Mosaic automàtic"

#. settings-schema.json->windowGap->description
msgid ""
"Gap between tiled windows (set with − / + in the preset panel; not shown in "
"this dialog)"
msgstr ""
"Espai entre les finestres en mosaic (es defineix amb − / + al tauler de "
"predefinicions; no es mostra en aquest diàleg)"

#. settings-schema.json->windowGap->units
msgid "px"
msgstr "px"

#. settings-schema.json->tileAnimation->description
msgid "Animate tiling"
msgstr "Anima el mosaic"

#. settings-schema.json->tileAnimation->tooltip
msgid "Windows glide into their new place. Off: they jump there at once."
msgstr ""
"Les finestres llisquen fins al seu lloc nou. Desactivat: hi salten de cop."

#. settings-schema.json->focusBorder->description
msgid "Border around the focused window"
msgstr "Vora al voltant de la finestra enfocada"

#. settings-schema.json->focusBorder->tooltip
msgid ""
"After a Super+Arrow focus move, mark the newly focused window with a thin "
"border in the state color for three seconds."
msgstr ""
"Després de moure el focus amb Super+Fletxa, marca la finestra que rep el "
"focus amb una vora prima del color d'estat durant tres segons."

#. settings-schema.json->fillSingleWindow->description
msgid "Fill the monitor with a single window"
msgstr "Omple el monitor amb una única finestra"

#. settings-schema.json->fillSingleWindow->tooltip
msgid ""
"With automatic tiling or a preset on, a single tiled window fills the whole "
"usable area instead of being left untouched."
msgstr ""
"Amb el mosaic automàtic o una predefinició actius, una única finestra en "
"mosaic omple tota l'àrea útil en lloc de deixar-se sense tocar."

#. settings-schema.json->panelTheme->description
msgid "Theme of the preset panel"
msgstr "Tema del tauler de predefinicions"

#. settings-schema.json->panelTheme->tooltip
msgid ""
"Follow system tracks the desktop color scheme live; Light and Dark override "
"it."
msgstr ""
"Segueix el sistema s'adapta en directe a l'esquema de colors de "
"l'escriptori; Clar i Fosc el substitueixen."

#. settings-schema.json->panelTheme->options
msgid "Follow system"
msgstr "Segueix el sistema"

#. settings-schema.json->panelTheme->options
msgid "Light"
msgstr "Clar"

#. settings-schema.json->panelTheme->options
msgid "Dark"
msgstr "Fosc"

#. settings-schema.json->accentMode->description
msgid "Accent color"
msgstr "Color d'èmfasi"

#. settings-schema.json->accentMode->tooltip
msgid ""
"Follow theme tracks the accent color of the Cinnamon theme live. Custom uses"
" the color below."
msgstr ""
"Segueix el tema adopta en directe el color d'èmfasi del tema de Cinnamon. "
"Personalitzat utilitza el color de sota."

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Follow theme"
msgstr "Segueix el tema"

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Custom"
msgstr "Personalitzat"

#. settings-schema.json->accentColor->description
msgid "Custom accent color"
msgstr "Color d'èmfasi personalitzat"

#. settings-schema.json->accentColor->tooltip
msgid "Accent of the preset panel and editor when Accent color is Custom."
msgstr ""
"Èmfasi del tauler de predefinicions i de l'editor quan Color d'èmfasi és "
"Personalitzat."

#. settings-schema.json->stateMode->description
msgid "State color"
msgstr "Color d'estat"

#. settings-schema.json->stateMode->tooltip
msgid ""
"Color of the \"Auto: on\" marker and the assigned rows. Green keeps today's "
"look. Follow theme tracks the accent color of the Cinnamon theme live. "
"Custom uses the color below."
msgstr ""
"Color del marcador «Auto: activat» i de les files assignades. Verd manté "
"l'aspecte actual. Segueix el tema adopta en directe el color d'èmfasi del "
"tema de Cinnamon. Personalitzat utilitza el color de sota."

#. settings-schema.json->stateMode->options
msgid "Green"
msgstr "Verd"

#. settings-schema.json->stateColor->description
msgid "Custom state color"
msgstr "Color d'estat personalitzat"

#. settings-schema.json->stateColor->tooltip
msgid "State color of the preset panel when State color is Custom."
msgstr ""
"Color d'estat del tauler de predefinicions quan Color d'estat és "
"Personalitzat."

#~ msgid ""
#~ "Draw a thin border in the state color around the focused window while "
#~ "automatic tiling is on."
#~ msgstr ""
#~ "Dibuixa una vora prima del color d'estat al voltant de la finestra enfocada "
#~ "mentre el mosaic automàtic estigui actiu."
