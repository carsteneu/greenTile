#. settings-schema.json->hotkeys-legend->description
#, fuzzy
#| msgid ""
#| "Escape:\t\t\tHide gTile\n"
#| "Enter or Space:\tCommit current selection\n"
#| "Left:\t\t\tMove Left inside Grid\n"
#| "Right:\t\t\tMove Right inside Grid\n"
#| "Up:\t\t\t\tMove Up inside Grid\n"
#| "Down:\t\t\tMove Down inside Grid\n"
#| "<Shift>Left:\t\tInclude column to the Left in selection\n"
#| "<Shift>Right:\t\tInclude column to the Right in selection\n"
#| "<Shift>Up:\t\tInclude row Above in selection\n"
#| "<Shift>Down:\tInclude row Below in selection\n"
#| "<Alt>Left:\t\tMove to the monitor on the Left\n"
#| "<Alt>Right:\t\tMove to the monitor on the Right\n"
#| "<Alt>Up:\t\t\tMove to the monitor Above\n"
#| "<Alt>Down:\t\tMove to the monitor Below\n"
#| "1:\t\t\t\tSelect the first grid layout\n"
#| "2:\t\t\t\tSelect the second grid layout\n"
#| "3:\t\t\t\tSelect the third grid layout\n"
#| "4:\t\t\t\tSelect the fourth grid layout"
msgid ""
"Escape:\t\t\tHide greenTile\n"
"Enter or Space:\tCommit current selection\n"
"Left:\t\t\tMove Left inside Grid\n"
"Right:\t\t\tMove Right inside Grid\n"
"Up:\t\t\t\tMove Up inside Grid\n"
"Down:\t\t\tMove Down inside Grid\n"
"<Shift>Left:\t\tInclude column to the Left in selection\n"
"<Shift>Right:\t\tInclude column to the Right in selection\n"
"<Shift>Up:\t\tInclude row Above in selection\n"
"<Shift>Down:\tInclude row Below in selection\n"
"<Alt>Left:\t\tMove to the monitor on the Left\n"
"<Alt>Right:\t\tMove to the monitor on the Right\n"
"<Alt>Up:\t\t\tMove to the monitor Above\n"
"<Alt>Down:\t\tMove to the monitor Below\n"
"1:\t\t\t\tSelect the first grid layout\n"
"2:\t\t\t\tSelect the second grid layout\n"
"3:\t\t\t\tSelect the third grid layout\n"
"4:\t\t\t\tSelect the fourth grid layout"
msgstr ""
"Échap:\\t\\tMasquer gTile\\n\n"
"Entrer ou Espace:\\tValider la sélection actuelle\\n\n"
"Gauche:\\t\\tDéplacer vers la gauche à l'intérieur de la grille\\n\n"
"Droite:\\t\\tDéplacer vers la droite à l'intérieur de la grille\\n\n"
"Haut:\\t\\t\\tDéplacer vers le haut à l'intérieur de la grille\\n\n"
"Bas:\\t\\tDéplacer vers le bas à l'intérieur de la grille.\n"
"<Shift>Gauche:\\t\\tInclure la colonne de gauche dans la sélection\\n\n"
"<Shift>Droite:\\t\\tInclure la colonne de droite dans la sélection\\n\n"
"<Shift>Haut:\\t\\tInclure la ligne au-dessus dans la sélection\\n\n"
"<Shift>Bas:\\tInclure la ligne au-dessous dans la sélection\\n\n"
"<Alt>Gauche:\\t\\tDéplacer vers le moniteur de gauche\\n\n"
"<Alt>Right:\\t\\tDéplacer vers le moniteur de droite\\n\n"
"<Alt>Haut:\\t\\tDéplacer vers le moniteur au dessus\\n\n"
"<Alt>Down:\\t\\tDéplacer vers le moniteur du bas\n"
"1:\\t\\t\\tSélectionner la première disposition de la grille\\n\n"
"2:\\t\\t\\tSelectionner la deuxième disposition de la grille\\n\n"
"3:\\t\\t\\tSelectionner la troisième disposition de la grille\\n\n"
"4:\\t\\t\\t\\tSelectionner la quatrième disposition de la grille"

