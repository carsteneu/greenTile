msgid ""
"Escape:\t\t\tHide greenTile\n"
"Enter or Space:\tCommit current selection\n"
"Left:\t\t\tMove Left inside Grid\n"
"Right:\t\t\tMove Right inside Grid\n"
"Up:\t\t\t\tMove Up inside Grid\n"
"Down:\t\t\tMove Down inside Grid\n"
"<Shift>Left:\t\tInclude column to the Left in selection\n"
"<Shift>Right:\t\tInclude column to the Right in selection\n"
"<Shift>Up:\t\tInclude row Above in selection\n"
"<Shift>Down:\tInclude row Below in selection\n"
"<Alt>Left:\t\tMove to the monitor on the Left\n"
"<Alt>Right:\t\tMove to the monitor on the Right\n"
"<Alt>Up:\t\t\tMove to the monitor Above\n"
"<Alt>Down:\t\tMove to the monitor Below\n"
"1:\t\t\t\tSelect the first grid layout\n"
"2:\t\t\t\tSelect the second grid layout\n"
"3:\t\t\t\tSelect the third grid layout\n"
"4:\t\t\t\tSelect the fourth grid layout"
msgstr ""
"Esc:\t\t\tEsconde o gTile\n"
"Enter ou Espaço:\tConfirma a seleção atual\n"
"Esquerda:\t\t\tMove para a esquerda dentro da grade\n"
"Direita:\t\t\tMove para a direita dentro da grade\n"
"Acima:\t\t\t\tMove para cima dentro da grade\n"
"Embaixo:\t\t\tMove para baixo dentro da grade\n"
"<Shift>Esquerda:\t\tInclui coluna à esquerda da seleção\n"
"<Shift>Direita:\t\tInclui coluna à direita da seleção\n"
"<Shift>Acima:\t\tInclui linha acima da seleção\n"
"<Shift>Embaixo:\tInclui linha abaixo da seleção\n"
"<Alt>Esquerda:\t\tMove para o monitor à esquerda\n"
"<Alt>Direita:\t\tMove para o monitor à direita\n"
"<Alt>Acima:\t\t\tMove para o monitor acima\n"
"<Alt>Embaixo:\t\tMove para o monitor abaixo\n"
"1:\t\t\t\tSeleciona o primeiro modelo de grade\n"
"2:\t\t\t\tSeleciona o segundo modelo de grade\n"
"3:\t\t\t\tSeleciona o terceiro modelo de grade\n"
"4:\t\t\t\tSeleciona o quarto modelo de grade"

