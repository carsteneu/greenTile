#. settings-schema.json->excludeAppPicker->options
#: greenTile.js:439
msgid "Add application …"
msgstr "Toepassing toevoegen …"

#: greenTile.js:458
msgid "Window floats"
msgstr "Venster zweeft"

#: greenTile.js:458
msgid "Window tiles again"
msgstr "Venster wordt weer getegeld"

#: greenTile.js:2771
#, javascript-format
msgid "assigned — workspace %d"
msgstr "toegewezen — werkblad %d"

#: greenTile.js:2832
msgid "Please enter a name."
msgstr "Voer een naam in."

#: greenTile.js:2874
#, javascript-format
msgid "from %d"
msgstr "vanaf %d"

#: greenTile.js:2991
msgid "Rules (by window count)"
msgstr "Regels (naar aantal vensters)"

#: greenTile.js:2995
msgid "Rule"
msgstr "Regel"

#: greenTile.js:2996
msgid "Delete rule"
msgstr "Regel verwijderen"

#: greenTile.js:3004
msgid "Rule applies from"
msgstr "Regel geldt vanaf"

#: greenTile.js:3011
msgid "windows"
msgstr "vensters"

#: greenTile.js:3013
msgid "Painter"
msgstr "Tekenvlak"

#: greenTile.js:3028
msgid ""
"Click or drag: the row sets how many windows the column holds. Right-click "
"removes a column."
msgstr ""
"Klik of sleep: de rij bepaalt hoeveel vensters de kolom bevat. Rechtsklik "
"verwijdert een kolom."

#: greenTile.js:3033
msgid "Name"
msgstr "Naam"

#: greenTile.js:3034
msgid "Preset name"
msgstr "Naam van voorinstelling"

#: greenTile.js:3039
msgid "Delete preset"
msgstr "Voorinstelling verwijderen"

#: greenTile.js:3042
msgid "Really delete?"
msgstr "Echt verwijderen?"

#: greenTile.js:3043
msgid "Delete"
msgstr "Verwijderen"

#: greenTile.js:3047
msgid "Save"
msgstr "Opslaan"

#: greenTile.js:3072
#, javascript-format
msgid "Result: %s"
msgstr "Resultaat: %s"

#: greenTile.js:3692
msgid "Gap between windows"
msgstr "Ruimte tussen vensters"

#: greenTile.js:3697
#, javascript-format
msgid "%d px"
msgstr "%d px"

#: greenTile.js:3716
msgid "Reset sizes"
msgstr "Afmetingen herstellen"

#: greenTile.js:3747
#, javascript-format
msgid "Presets — workspace %d · %s"
msgstr "Voorinstellingen — werkblad %d · %s"

#: greenTile.js:3749
msgid "Create preset"
msgstr "Voorinstelling maken"

#: greenTile.js:3749
#, javascript-format
msgid "Edit %s"
msgstr "%s bewerken"

#: greenTile.js:3753
msgid "Back"
msgstr "Terug"

#: greenTile.js:3762
msgid "Auto: on"
msgstr "Auto: aan"

#: greenTile.js:3762
msgid "Auto: off"
msgstr "Auto: uit"

#: greenTile.js:3783
msgid "Dark theme"
msgstr "Donker thema"

#: greenTile.js:3783
msgid "Light theme"
msgstr "Licht thema"

#: greenTile.js:3903
msgid "No presets yet."
msgstr "Nog geen voorinstellingen."

#: greenTile.js:3918
msgid "New preset"
msgstr "Nieuwe voorinstelling"

#: greenTile.js:3921
msgid "Click a row to apply it to this workspace and tile right away"
msgstr ""
"Klik op een rij om deze op dit werkblad toe te passen en meteen te tegelen"

#. metadata.json->name
msgid "greenTile"
msgstr "greenTile"

#. metadata.json->description
msgid ""
"Column tiling with per-workspace presets, auto mode and snap-on-release. "
"Fork of gTile by shuairan."
msgstr ""
"Tegelen in kolommen met voorinstellingen per werkblad, automatische modus en"
" uitlijnen bij loslaten. Fork van gTile door shuairan."

#. settings-schema.json->settings-tab->title
msgid "Settings"
msgstr "Instellingen"

#. settings-schema.json->hotkeys-tab->title
msgid "Hotkeys"
msgstr "Sneltoetsen"

#. settings-schema.json->autotile-hotkey-section->title
msgid "Auto-Tile Hotkeys"
msgstr "Sneltoetsen voor automatisch tegelen"

#. settings-schema.json->preset-section->title
msgid "Workspace Presets"
msgstr "Voorinstellingen voor werkbladen"

#. settings-schema.json->resize-section->title
msgid "Resize tiled windows"
msgstr "Grootte van getegelde vensters wijzigen"

#. settings-schema.json->swap-section->title
msgid "Swap windows"
msgstr "Vensters verwisselen"

#. settings-schema.json->tiling-section->title
msgid "Tiling"
msgstr "Tegelen"

#. settings-schema.json->exclusion-section->title
#. settings-schema.json->exclusion-hotkey-section->title
msgid "Never tile"
msgstr "Nooit tegelen"

#. settings-schema.json->panel-section->title
msgid "Preset panel"
msgstr "Voorinstellingenpaneel"

#. settings-schema.json->autotile6hotkey->description
msgid "Tile all windows into 6 columns"
msgstr "Alle vensters in 6 kolommen tegelen"

#. settings-schema.json->autotile3hotkey->description
msgid "Tile all windows into 3 columns"
msgstr "Alle vensters in 3 kolommen tegelen"

#. settings-schema.json->autotileautohotkey->description
msgid "Turn automatic tiling on for this workspace and tile now"
msgstr "Automatisch tegelen voor dit werkblad inschakelen en nu tegelen"

#. settings-schema.json->autotileoffhotkey->description
msgid "Turn automatic tiling off for this workspace"
msgstr "Automatisch tegelen voor dit werkblad uitschakelen"

#. settings-schema.json->presetHotkey->description
msgid "Open the preset panel"
msgstr "Voorinstellingenpaneel openen"

#. settings-schema.json->resizeWiderHotkey->description
msgid "Make the focused tiled window wider (tap = 1 px, hold to speed up)"
msgstr ""
"Het gefocuste getegelde venster breder maken (tikken = 1 px, ingedrukt "
"houden versnelt)"

#. settings-schema.json->resizeNarrowerHotkey->description
msgid "Make the focused tiled window narrower"
msgstr "Het gefocuste getegelde venster smaller maken"

#. settings-schema.json->resizeTallerHotkey->description
msgid "Make the focused tiled window taller"
msgstr "Het gefocuste getegelde venster hoger maken"

#. settings-schema.json->resizeShorterHotkey->description
msgid "Make the focused tiled window shorter"
msgstr "Het gefocuste getegelde venster lager maken"

#. settings-schema.json->swapLeftHotkey->description
msgid "Swap the focused tiled window with its neighbor to the left"
msgstr "Het gefocuste getegelde venster verwisselen met het buurvenster links"

#. settings-schema.json->swapRightHotkey->description
msgid "Swap the focused tiled window with its neighbor to the right"
msgstr ""
"Het gefocuste getegelde venster verwisselen met het buurvenster rechts"

#. settings-schema.json->swapUpHotkey->description
msgid "Swap the focused tiled window with its neighbor above"
msgstr ""
"Het gefocuste getegelde venster verwisselen met het buurvenster erboven"

#. settings-schema.json->swapDownHotkey->description
msgid "Swap the focused tiled window with its neighbor below"
msgstr ""
"Het gefocuste getegelde venster verwisselen met het buurvenster eronder"

#. settings-schema.json->presets->description
msgid "Preset definitions (JSON)"
msgstr "Definities van voorinstellingen (JSON)"

#. settings-schema.json->excludeHotkey->description
msgid "Toggle 'never tile' for the focused window"
msgstr "'Nooit tegelen' in- of uitschakelen voor het gefocuste venster"

#. settings-schema.json->excludeAppPicker->description
msgid "Add an installed application"
msgstr "Een geïnstalleerde toepassing toevoegen"

#. settings-schema.json->excludeAppPicker->tooltip
msgid ""
"Pick an application and it is added to the list below. The combobox resets "
"after each pick."
msgstr ""
"Kies een toepassing en die wordt aan de lijst hieronder toegevoegd. De "
"keuzelijst wordt na elke keuze teruggezet."

#. settings-schema.json->exclusions->description
msgid ""
"Windows matching one of these rows are never tiled; they float freely "
"wherever you put them"
msgstr ""
"Vensters die met een van deze rijen overeenkomen, worden nooit getegeld; ze "
"zweven vrij, waar ze ook worden neergezet"

#. settings-schema.json->exclusions->columns->title
msgid "Match"
msgstr "Vergelijking"

#. settings-schema.json->exclusions->columns->title
msgid "Text"
msgstr "Tekst"

#. settings-schema.json->wsPresets->description
msgid "Workspace to preset assignments (JSON)"
msgstr "Toewijzing van voorinstellingen aan werkbladen (JSON)"

#. settings-schema.json->autoWorkspaces->description
msgid ""
"Automatic tiling per workspace (set with Super+Ctrl+A / Super+Ctrl+D or in "
"the preset panel; not shown in this dialog)"
msgstr ""
"Automatisch tegelen per werkblad (in te stellen met Super+Ctrl+A / "
"Super+Ctrl+D of in het voorinstellingenpaneel; niet getoond in dit venster)"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Workspace"
msgstr "Werkblad"

#. settings-schema.json->autoWorkspaces->columns->title
msgid "Tile automatically"
msgstr "Automatisch tegelen"

#. settings-schema.json->windowGap->description
msgid ""
"Gap between tiled windows (set with − / + in the preset panel; not shown in "
"this dialog)"
msgstr ""
"Ruimte tussen getegelde vensters (in te stellen met − / + in het "
"voorinstellingenpaneel; niet getoond in dit venster)"

#. settings-schema.json->windowGap->units
msgid "px"
msgstr "px"

#. settings-schema.json->tileAnimation->description
msgid "Animate tiling"
msgstr "Tegelen animeren"

#. settings-schema.json->tileAnimation->tooltip
msgid "Windows glide into their new place. Off: they jump there at once."
msgstr ""
"Vensters glijden naar hun nieuwe plek. Uit: ze springen er meteen heen."

#. settings-schema.json->focusBorder->description
msgid "Border around the focused window"
msgstr "Rand om het gefocuste venster"

#. settings-schema.json->focusBorder->tooltip
msgid ""
"After a Super+Arrow focus move, mark the newly focused window with a thin "
"border in the state color for three seconds."
msgstr ""
"Markeert na een focuswissel met Super+Pijl het nieuw gefocuste venster drie "
"seconden lang met een dunne rand in de statuskleur."

#. settings-schema.json->fillSingleWindow->description
msgid "Fill the monitor with a single window"
msgstr "Beeldscherm vullen met één venster"

#. settings-schema.json->fillSingleWindow->tooltip
msgid ""
"With automatic tiling or a preset on, a single tiled window fills the whole "
"usable area instead of being left untouched."
msgstr ""
"Met automatisch tegelen of een voorinstelling actief vult één getegeld "
"venster het hele bruikbare gebied in plaats van onaangeroerd te blijven."

#. settings-schema.json->panelTheme->description
msgid "Theme of the preset panel"
msgstr "Thema van het voorinstellingenpaneel"

#. settings-schema.json->panelTheme->tooltip
msgid ""
"Follow system tracks the desktop color scheme live; Light and Dark override "
"it."
msgstr ""
"Systeem volgen volgt live het kleurenschema van het bureaublad; Licht en "
"Donker overschrijven dit."

#. settings-schema.json->panelTheme->options
msgid "Follow system"
msgstr "Systeem volgen"

#. settings-schema.json->panelTheme->options
msgid "Light"
msgstr "Licht"

#. settings-schema.json->panelTheme->options
msgid "Dark"
msgstr "Donker"

#. settings-schema.json->accentMode->description
msgid "Accent color"
msgstr "Accentkleur"

#. settings-schema.json->accentMode->tooltip
msgid ""
"Follow theme tracks the accent color of the Cinnamon theme live. Custom uses"
" the color below."
msgstr ""
"Thema volgen neemt live de accentkleur van het Cinnamon-thema over. "
"Aangepast gebruikt de kleur hieronder."

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Follow theme"
msgstr "Thema volgen"

#. settings-schema.json->accentMode->options
#. settings-schema.json->stateMode->options
msgid "Custom"
msgstr "Aangepast"

#. settings-schema.json->accentColor->description
msgid "Custom accent color"
msgstr "Aangepaste accentkleur"

#. settings-schema.json->accentColor->tooltip
msgid "Accent of the preset panel and editor when Accent color is Custom."
msgstr ""
"Accent van het voorinstellingenpaneel en de editor als Accentkleur op "
"Aangepast staat."

#. settings-schema.json->stateMode->description
msgid "State color"
msgstr "Statuskleur"

#. settings-schema.json->stateMode->tooltip
msgid ""
"Color of the \"Auto: on\" marker and the assigned rows. Green keeps today's "
"look. Follow theme tracks the accent color of the Cinnamon theme live. "
"Custom uses the color below."
msgstr ""
"Kleur van de markering \"Auto: aan\" en de toegewezen rijen. Groen behoudt "
"het huidige uiterlijk. Thema volgen neemt live de accentkleur van het "
"Cinnamon-thema over. Aangepast gebruikt de kleur hieronder."

#. settings-schema.json->stateMode->options
msgid "Green"
msgstr "Groen"

#. settings-schema.json->stateColor->description
msgid "Custom state color"
msgstr "Aangepaste statuskleur"

#. settings-schema.json->stateColor->tooltip
msgid "State color of the preset panel when State color is Custom."
msgstr ""
"Statuskleur van het voorinstellingenpaneel als Statuskleur op Aangepast "
"staat."

#~ msgid ""
#~ "Draw a thin border in the state color around the focused window while "
#~ "automatic tiling is on."
#~ msgstr ""
#~ "Tekent een dunne rand in de statuskleur om het gefocuste venster zolang "
#~ "automatisch tegelen aan staat."
